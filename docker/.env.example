# ZKER 环境变量配置
# 适用于所有Docker服务

# ========== MySQL配置 ==========
MYSQL_ROOT_PASSWORD=root_password_2025
MYSQL_DATABASE=zker
MYSQL_USER=zker_app
MYSQL_PASSWORD=app_password_2025

# ========== ProxySQL配置 ==========
PROXYSQL_ADMIN_PASSWORD=admin_password_2025
PROXYSQL_MONITOR_PASSWORD=monitor_password_2025

# ========== Redis配置 ==========
REDIS_PASSWORD=redis_password_2025

# ========== Kong配置 ==========
KONG_PG_HOST=konga-postgres
KONG_PG_DATABASE=konga
KONG_PG_USER=konga
KONG_PG_PASSWORD=konga_password_2025

# ========== PostgreSQL配置 (Konga) ==========
POSTGRES_USER=konga
POSTGRES_PASSWORD=konga_password_2025
POSTGRES_DB=konga

# ========== 应用配置 ==========
APP_ENV=production
APP_LOG_LEVEL=info
APP_PORT=8080

# ========== 监控配置 ==========
PROMETHEUS_RETENTION_TIME=15d
ALERTMANSHIP_RETENTION_TIME=120h

# ========== 追踪配置 ==========
JAEGER_ENDPOINT=http://jaeger:14268/api/traces
JAEGER_SAMPLER_RATE=0.1

# ========== 日志配置 ==========
LOG_LEVEL=info
LOG_FORMAT=json
LOG_OUTPUT=file
LOG_PATH=/var/log/zker
