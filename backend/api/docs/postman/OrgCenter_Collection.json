{
  "info": {
    "name": "组织中心管理API",
    "description": "企业级组织管理系统的完整API集合，支持组织、部门、员工、岗位管理和通讯录服务",
    "version": "v1.0.0",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{api_token}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// 集合级别前置脚本",
          "// 自动刷新Token",
          "",
          "const token = pm.environment.get('api_token');",
          "const expiresAt = pm.environment.get('token_expires_at');",
          "",
          "if (expiresAt && Date.now() > parseInt(expiresAt)) {",
          "    console.log('Token已过期，需要刷新');",
          "    // TODO: 调用刷新Token接口",
          "}"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// 集合级别测试脚本",
          "",
          "pm.test('响应状态码应为200或201', function () {",
          "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
          "});",
          "",
          "pm.test('响应应为JSON格式', function () {",
          "    pm.response.to.have.header('Content-Type');",
          "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
          "});",
          "",
          "const jsonData = pm.response.json();",
          "",
          "pm.test('业务状态码应为0', function () {",
          "    pm.expect(jsonData.code).to.eql(0);",
          "});"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "tenant_id",
      "value": "tenant_001",
      "type": "string"
    },
    {
      "key": "api_token",
      "value": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...",
      "type": "string"
    },
    {
      "key": "org_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "dept_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "emp_id",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "认证",
      "item": [
        {
          "name": "登录获取Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('登录成功', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});",
                  "",
                  "const jsonData = pm.response.json();",
                  "",
                  "pm.test('返回Token', function () {",
                  "    pm.expect(jsonData.data).to.have.property('token');",
                  "});",
                  "",
                  "// 保存Token到环境变量",
                  "if (jsonData.data && jsonData.data.token) {",
                  "    pm.environment.set('api_token', jsonData.data.token);",
                  "    const expiresIn = jsonData.data.expires_in || 7200;",
                  "    pm.environment.set('token_expires_at', Date.now() + expiresIn * 1000);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"your_password\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "login"]
            }
          },
          "response": []
        }
      ],
      "description": "认证相关接口"
    },
