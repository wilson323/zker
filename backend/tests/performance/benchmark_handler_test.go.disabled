// =====================================================
// HTTP 请求处理性能测试
// =====================================================

// BenchmarkHTTP_RequestParsing 测试请求解析性能
func BenchmarkHTTP_RequestParsing(b *testing.B) {
	s := setupTestServer()

	reqBody := map[string]interface{}{
		"tenant_name": "test_tenant",
		"tenant_desc": "test description",
		"admin_email": "admin@test.com",
		"metadata": map[string]interface{}{
			"key1": "value1",
			"key2": "value2",
			"key3": "value3",
		},
	}

	bodyBytes, _ := json.Marshal(reqBody)

	b.ResetTimer()
	b.ReportAllocs()

	for i := 0; i < b.N; i++ {
		req := httptest.NewRequest("POST", "/api/tenant/create", bytes.NewReader(bodyBytes))
		req.Header.Set("Content-Type", "application/json")

		_ = req // 仅测试解析性能
	}
}

// BenchmarkHTTP_ResponseSerialization 测试响应序列化性能
func BenchmarkHTTP_ResponseSerialization(b *testing.B) {
	responseData := map[string]interface{}{
		"code":    0,
		"message": "success",
		"data": map[string]interface{}{
			"tenant_id":   "test_tenant_123",
			"tenant_name": "Test Tenant",
			"tenant_desc": "Test Description",
			"created_at":  "2025-01-01T00:00:00Z",
			"updated_at":  "2025-01-01T00:00:00Z",
		},
	}

	b.ResetTimer()
	b.ReportAllocs()

	for i := 0; i < b.N; i++ {
		_, err := json.Marshal(responseData)
		if err != nil {
			b.Fatalf("Serialization failed: %v", err)
		}
	}
}

// BenchmarkHTTP_MultipartFormData 测试 Multipart 表单数据处理性能
func BenchmarkHTTP_MultipartFormData(b *testing.B) {
	b.ResetTimer()
	b.ReportAllocs()

	for i := 0; i < b.N; i++ {
		body := &bytes.Buffer{}
		writer := multipart.NewWriter(body)

		writer.WriteField("tenant_name", "test_tenant")
		writer.WriteField("tenant_desc", "test description")
		writer.WriteField("admin_email", "admin@test.com")

		// 添加文件上传
		part, _ := writer.CreateFormFile("icon", "icon.png")
		part.Write([]byte("fake image data"))

		writer.Close()

		req := httptest.NewRequest("POST", "/api/tenant/create_with_icon", body)
		req.Header.Set("Content-Type", writer.FormDataContentType())

		_ = req
	}
}

