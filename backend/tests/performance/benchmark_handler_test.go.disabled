	s := setupTestServer()

	// 为每次迭代创建新租户
	tenantIDs := make([]string, b.N)
	// ... (省略创建租户的代码)

	b.ResetTimer()
	b.ReportAllocs()

	for i := 0; i < b.N; i++ {
		req := httptest.NewRequest("DELETE", "/api/tenant/"+tenantIDs[i], nil)
		req.Header.Set("X-Tenant-ID", "test_tenant")
		req.Header.Set("X-User-ID", "test_user")

		w := httptest.NewRecorder()
		s.ServeHTTP(w, req)

		if w.Code != consts.StatusOK && w.Code != consts.StatusNoContent {
