		w := httptest.NewRecorder()
		s.ServeHTTP(w, req)
	}
}

// BenchmarkMiddleware_Authentication 测试认证中间件性能
func BenchmarkMiddleware_Authentication(b *testing.B) {
	s := setupTestServer()

	b.ResetTimer()
	b.ReportAllocs()

	for i := 0; i < b.N; i++ {
		req := httptest.NewRequest("GET", "/api/tenant/detail", nil)
		req.Header.Set("Authorization", "Bearer fake_token")
		req.Header.Set("X-Tenant-ID", "test_tenant")

		w := httptest.NewRecorder()
		s.ServeHTTP(w, req)
	}
}

// BenchmarkMiddleware_RateLimiting 测试限流中间件性能
func BenchmarkMiddleware_RateLimiting(b *testing.B) {
	s := setupTestServer()

	b.ResetTimer()
	b.ReportAllocs()

	for i := 0; i < b.N; i++ {
		req := httptest.NewRequest("GET", "/api/tenant/detail", nil)
		req.Header.Set("X-Tenant-ID", "test_tenant")
		req.Header.Set("X-User-ID", "test_user")
		req.Header.Set("X-Forwarded-For", "192.168.1.1")

		w := httptest.NewRecorder()
		s.ServeHTTP(w, req)
	}
}

// =====================================================
// 并发请求处理性能测试
// =====================================================

// BenchmarkHandler_ConcurrentRequests 测试并发请求处理性能
func BenchmarkHandler_ConcurrentRequests(b *testing.B) {
	s := setupTestServer()
	tenantID := "test_tenant_concurrent"

	b.ResetTimer()
	b.ReportAllocs()

	b.RunParallel(func(pb *testing.PB) {
		for pb.Next() {
			req := httptest.NewRequest("GET", "/api/tenant/"+tenantID+"/detail", nil)
			req.Header.Set("X-Tenant-ID", tenantID)
			req.Header.Set("X-User-ID", "test_user")

			w := httptest.NewRecorder()
			s.ServeHTTP(w, req)
		}
	})
}

// =====================================================
// 错误处理性能测试
// =====================================================

// BenchmarkHandler_ErrorResponse 测试错误响应性能
func BenchmarkHandler_ErrorResponse(b *testing.B) {
	s := setupTestServer()

	b.ResetTimer()
	b.ReportAllocs()

	for i := 0; i < b.N; i++ {
		// 故意请求不存在的租户
		req := httptest.NewRequest("GET", "/api/tenant/non_existent_tenant/detail", nil)
		req.Header.Set("X-Tenant-ID", "test_tenant")
		req.Header.Set("X-User-ID", "test_user")

		w := httptest.NewRecorder()
		s.ServeHTTP(w, req)

		// 预期 404 或其他错误状态码
		if w.Code == consts.StatusOK {
			b.Fatal("Expected error status, got 200")
		}
	}
}

// BenchmarkHandler_ValidationErrors 测试验证错误处理性能
func BenchmarkHandler_ValidationErrors(b *testing.B) {
	s := setupTestServer()

	invalidReqBodies := []map[string]interface{}{
		{"tenant_name": ""}, // 空名称
		{"admin_email": "invalid-email"}, // 无效邮箱
		{"tenant_name": "a"}, // 名称太短
	}

	b.ResetTimer()
	b.ReportAllocs()

	for i := 0; i < b.N; i++ {
		reqBody := invalidReqBodies[i%len(invalidReqBodies)]
		bodyBytes, _ := json.Marshal(reqBody)

		req := httptest.NewRequest("POST", "/api/tenant/create", bytes.NewReader(bodyBytes))
		req.Header.Set("Content-Type", "application/json")
		req.Header.Set("X-Tenant-ID", "test_tenant")
		req.Header.Set("X-User-ID", "test_user")

		w := httptest.NewRecorder()
		s.ServeHTTP(w, req)

		// 预期验证错误
		if w.Code == consts.StatusOK || w.Code == consts.StatusCreated {
			b.Fatal("Expected validation error, got success")
		}
	}
}

// =====================================================
// Context 处理性能测试
// =====================================================

// BenchmarkHandler_ContextExtraction 测试 Context 提取性能
func BenchmarkHandler_ContextExtraction(b *testing.B) {
	ctx := context.Background()
	c := app.NewRequestContext()

	// 模拟设置 context 数据
	c.Set("tenant_id", "test_tenant")
	c.Set("user_id", "test_user")
	c.Set("session_id", "test_session")

	b.ResetTimer()
	b.ReportAllocs()

	for i := 0; i < b.N; i++ {
		_ = c.GetString("tenant_id")
		_ = c.GetString("user_id")
		_ = c.GetString("session_id")
	}
}

// =====================================================
// JSON 处理性能对比
// =====================================================

// BenchmarkJSON_StandardLibrary vs BenchmarkJSON_ThirdParty
// 对比标准库与第三方 JSON 库性能

func BenchmarkJSON_StandardLibrary(b *testing.B) {
	data := map[string]interface{}{
		"tenant_id":   "test_tenant_123",
		"tenant_name": "Test Tenant",
		"metadata": map[string]interface{}{
			"key1": "value1",
			"key2": 12345,
			"key3": true,
		},
	}

	b.ResetTimer()
	b.ReportAllocs()

	for i := 0; i < b.N; i++ {
		_, err := json.Marshal(data)
		if err != nil {
			b.Fatalf("JSON marshal failed: %v", err)
		}
	}
}

func BenchmarkJSON_LargePayload 测试大JSON负载处理性能
func BenchmarkJSON_LargePayload(b *testing.B) {
	// 模拟大数据量的 JSON
	largeData := make(map[string]interface{})
	for i := 0; i < 100; i++ {
		largeData["key"+string(rune(i))] = map[string]interface{}{
			"field1": "value1",
			"field2": i,
			"field3": []int{1, 2, 3, 4, 5},
		}
	}

	b.ResetTimer()
	b.ReportAllocs()

	for i := 0; i < b.N; i++ {
		_, err := json.Marshal(largeData)
		if err != nil {
			b.Fatalf("JSON marshal failed: %v", err)
		}
	}
}

// =====================================================
// IO 操作性能测试
// =====================================================

// BenchmarkHandler_IOOperations 测试 IO 操作性能
func BenchmarkHandler_IOOperations(b *testing.B) {
	s := setupTestServer()

	// 创建大文件上传请求
	largeBody := make([]byte, 1024*1024) // 1MB

	b.ResetTimer()
	b.ReportAllocs()

	for i := 0; i < b.N; i++ {
		req := httptest.NewRequest("POST", "/api/tenant/upload_icon", bytes.NewReader(largeBody))
		req.Header.Set("Content-Type", "application/octet-stream")
		req.Header.Set("X-Tenant-ID", "test_tenant")

		w := httptest.NewRecorder()
		s.ServeHTTP(w, req)
	}
}

// BenchmarkHandler_ResponseStreaming 测试响应流式传输性能
func BenchmarkHandler_ResponseStreaming(b *testing.B) {
	s := setupTestServer()

	b.ResetTimer()
	b.ReportAllocs()

	for i := 0; i < b.N; i++ {
		req := httptest.NewRequest("GET", "/api/tenant/export_data", nil)
		req.Header.Set("X-Tenant-ID", "test_tenant")
		req.Header.Set("X-User-ID", "test_user")

		w := httptest.NewRecorder()
		s.ServeHTTP(w, req)

		// 读取响应体
		if w.Code == consts.StatusOK {
			_, _ = io.ReadAll(w.Body)
		}
	}
}
