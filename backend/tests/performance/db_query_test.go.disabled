// =====================================================
// JOIN查询性能测试
// =====================================================

// BenchmarkPluginQuery_WithJoin 使用JOIN查询
func BenchmarkPluginQuery_WithJoin(b *testing.B) {
	ctx := context.Background()
	dao := setupPluginDAO(b)

	option := &dal.PluginSelectedOption{
		WithDraft:    true,
		WithVersion:  true,
		WithTool:     true,
		WithOAuth:    true,
		Page:         1,
		PageSize:     20,
	}

	b.ResetTimer()
	b.ReportAllocs()

	for i := 0; i < b.N; i++ {
		option.Page = (i % 50) + 1
		_, _ = dao.Query(ctx, option)
	}
}

// BenchmarkPluginQuery_NoJoin 不使用JOIN的N+1查询
func BenchmarkPluginQuery_NoJoin(b *testing.B) {
	ctx := context.Background()
	dao := setupPluginDAO(b)

	option := &dal.PluginSelectedOption{
		Page:     1,
		PageSize: 20,
	}

	b.ResetTimer()
	b.ReportAllocs()

	for i := 0; i < b.N; i++ {
		option.Page = (i % 50) + 1
		plugins, _ := dao.Query(ctx, option)

		// 模拟N+1查询
		for _, plugin := range plugins {
			_, _ = dao.GetByID(ctx, plugin.PluginID, &dal.PluginSelectedOption{})
		}
	}
}

// =====================================================
// 索引效果对比测试
// =====================================================

// BenchmarkDBQuery_WithIndex 使用索引查询
func BenchmarkDBQuery_WithIndex(b *testing.B) {
	db := setupTestDB(b)

	b.ResetTimer()
	b.ReportAllocs()

	for i := 0; i < b.N; i++ {
		var result []map[string]interface{}
		db.Raw("SELECT * FROM plugins WHERE plugin_id = ?", i%1000).Scan(&result)
		_ = result
	}
}

// BenchmarkDBQuery_WithoutIndex 全表扫描（无索引）
func BenchmarkDBQuery_WithoutIndex(b *testing.B) {
	db := setupTestDB(b)

	b.ResetTimer()
	b.ReportAllocs()

	for i := 0; i < b.N; i++ {
		var result []map[string]interface{}
		// 模拟无索引的查询（使用LIKE而非索引列）
		db.Raw("SELECT * FROM plugins WHERE name LIKE ?", fmt.Sprintf("%%%d%%", i%100)).Scan(&result)
		_ = result
	}
}

// BenchmarkDBQuery_CompositeIndex 复合索引查询
func BenchmarkDBQuery_CompositeIndex(b *testing.B) {
	db := setupTestDB(b)

	b.ResetTimer()
	b.ReportAllocs()

	for i := 0; i < b.N; i++ {
		var result []map[string]interface{}
		// 假设有 (tenant_id, status, created_at) 复合索引
		db.Raw("SELECT * FROM plugins WHERE tenant_id = ? AND status = 'active' ORDER BY created_at DESC LIMIT 20",
			i%100).Scan(&result)
		_ = result
	}
}

// =====================================================
// 事务性能测试
// =====================================================

// BenchmarkDBTransaction_SingleInsert 单条插入（事务）
func BenchmarkDBTransaction_SingleInsert(b *testing.B) {
	db := setupTestDB(b)

	b.ResetTimer()
	b.ReportAllocs()

	for i := 0; i < b.N; i++ {
		db.Transaction(func(tx *gorm.DB) error {
			plugin := map[string]interface{}{
				"plugin_id":   i,
				"name":        fmt.Sprintf("Plugin %d", i),
				"tenant_id":   1,
				"created_at":  time.Now(),
				"updated_at":  time.Now(),
			}
			return tx.Table("plugins").Create(&plugin).Error
		})
	}
}

// BenchmarkDBTransaction_BatchInsert 批量插入（事务）
func BenchmarkDBTransaction_BatchInsert(b *testing.B) {
	db := setupTestDB(b)

	b.ResetTimer()
	b.ReportAllocs()

	for i := 0; i < b.N; i++ {
		batchSize := 100
		plugins := make([]map[string]interface{}, batchSize)

		for j := 0; j < batchSize; j++ {
			plugins[j] = map[string]interface{}{
				"plugin_id":  i*batchSize + j,
				"name":       fmt.Sprintf("Plugin %d", i*batchSize+j),
				"tenant_id":  1,
				"created_at": time.Now(),
				"updated_at": time.Now(),
			}
		}

		db.Transaction(func(tx *gorm.DB) error {
			return tx.Table("plugins").Create(&plugins).Error
		})
	}
}

// BenchmarkDBTransaction_ComplexUpdate 复杂更新（事务）
func BenchmarkDBTransaction_ComplexUpdate(b *testing.B) {
	db := setupTestDB(b)

	b.ResetTimer()
	b.ReportAllocs()

	for i := 0; i < b.N; i++ {
		db.Transaction(func(tx *gorm.DB) error {
			pluginID := i%1000 + 1

			// 更新主表
			tx.Table("plugins").Where("plugin_id = ?", pluginID).Update("updated_at", time.Now())

			// 更新关联表
			tx.Table("plugin_drafts").Where("plugin_id = ?", pluginID).Update("updated_at", time.Now())

			// 插入审计日志
			tx.Table("audit_logs").Create(map[string]interface{}{
				"plugin_id":  pluginID,
				"action":     "update",
				"created_at": time.Now(),
			})

			return nil
		})
	}
}

// =====================================================
// 连接池性能测试
// =====================================================

// BenchmarkDBConnectionPool_GetConnection 获取连接性能
func BenchmarkDBConnectionPool_GetConnection(b *testing.B) {
	db := setupTestDB(b)

	b.ResetTimer()
	b.ReportAllocs()

	for i := 0; i < b.N; i++ {
		sqlDB, _ := db.DB()
		conn, _ := sqlDB.Conn(context.Background())
		var result int
		conn.QueryRow(context.Background(), "SELECT 1").Scan(&result)
		_ = result
		conn.Close()
	}
}

// BenchmarkDBConnectionPool_ParallelQueries 并发查询
func BenchmarkDBConnectionPool_ParallelQueries(b *testing.B) {
	db := setupTestDB(b)

	b.ResetTimer()
	b.ReportAllocs()

	b.RunParallel(func(pb *testing.PB) {
		for pb.Next() {
			var count int64
			db.Table("plugins").Count(&count)
			_ = count
		}
	})
}

