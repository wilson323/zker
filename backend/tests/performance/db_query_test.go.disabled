// =====================================================
// 数据库查询性能测试
// =====================================================

// BenchmarkPluginMGet_Small 批量查询小数据集性能测试 (10条)
func BenchmarkPluginMGet_Small(b *testing.B) {
	ctx := context.Background()
	dao := setupPluginDAO(b)

	pluginIDs := make([]int64, 10)
	for i := 0; i < 10; i++ {
		pluginIDs[i] = int64(i + 1)
	}

	b.ResetTimer()
	b.ReportAllocs()

	for i := 0; i < b.N; i++ {
		_, _ = dao.MGet(ctx, pluginIDs, &dal.PluginSelectedOption{})
	}
}

// BenchmarkPluginMGet_Medium 批量查询中等数据集性能测试 (100条)
func BenchmarkPluginMGet_Medium(b *testing.B) {
