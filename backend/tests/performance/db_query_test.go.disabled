// BenchmarkPluginMGetParallel 并发批量查询性能测试
func BenchmarkPluginMGetParallel(b *testing.B) {
	ctx := context.Background()
	dao := setupPluginDAO(b)

	pluginIDs := make([]int64, 100)
	for i := 0; i < 100; i++ {
		pluginIDs[i] = int64(i + 1)
	}

	b.ResetTimer()
	b.ReportAllocs()

	b.RunParallel(func(pb *testing.PB) {
		for pb.Next() {
			_, _ = dao.MGet(ctx, pluginIDs, &dal.PluginSelectedOption{})
		}
	})
}

