func TestBudgetAlertService_CheckBudget_NoBudget(t *testing.T) {
	// 准备测试数据
	budgetRepo := &mockBudgetSettingsRepository{budgets: make(map[string]*entity.BudgetSettings)}
	summaryRepo := &mockTokenUsageSummaryRepository{}
	alertRepo := &mockBudgetAlertRepository{alerts: make(map[uint64]*entity.BudgetAlert), alertsSentToday: make(map[string]bool)}
	notifier := &mockNotificationService{}
	logger := logrus.New()
	logger.SetOutput(logrus.New().Writer())

	service := NewBudgetAlertService(budgetRepo, summaryRepo, alertRepo, notifier, logger)

	// 执行测试
	ctx := context.Background()
	err := service.CheckBudget(ctx, "tenant_no_budget")

	// 验证结果
	require.NoError(t, err, "未配置预算时不应该报错")
	assert.False(t, notifier.sendAlertCalled, "不应该发送告警")
}

func TestBudgetAlertService_CheckBudget_HardCapDisabled(t *testing.T) {
	// 准备测试数据
	budget := &entity.BudgetSettings{
		TenantID:        "tenant_test_001",
		BudgetAmount:    1000.0,
		HardCapEnabled:  false, // 未启用硬性上限
		AlertThreshold1: 80,
		AlertThreshold2: 95,
	}

	budgetRepo := &mockBudgetSettingsRepository{budgets: map[string]*entity.BudgetSettings{
		"tenant_test_001": budget,
	}}
	summaryRepo := &mockTokenUsageSummaryRepository{totalCost: 850.0}
	alertRepo := &mockBudgetAlertRepository{alerts: make(map[uint64]*entity.BudgetAlert), alertsSentToday: make(map[string]bool)}
	notifier := &mockNotificationService{}
	logger := logrus.New()

	service := NewBudgetAlertService(budgetRepo, summaryRepo, alertRepo, notifier, logger)

	// 执行测试
	ctx := context.Background()
	err := service.CheckBudget(ctx, "tenant_test_001")

	// 验证结果
	require.NoError(t, err)
	assert.False(t, notifier.sendAlertCalled, "未启用硬性上限时不应该发送告警")
}

func TestBudgetAlertService_CheckBudget_FirstThreshold(t *testing.T) {
	// 准备测试数据 - 使用率80%
	budget := &entity.BudgetSettings{
		TenantID:              "tenant_test_001",
		BudgetType:            entity.BudgetTypeMonthly,
		BudgetAmount:          1000.0,
		HardCapEnabled:        true,
		AlertThreshold1:       80,
		AlertThreshold2:       95,
		NotificationChannels:  `["email"]`,
	}

	budgetRepo := &mockBudgetSettingsRepository{budgets: map[string]*entity.BudgetSettings{
		"tenant_test_001": budget,
	}}
	summaryRepo := &mockTokenUsageSummaryRepository{totalCost: 800.0} // 80%
	alertRepo := &mockBudgetAlertRepository{
		alerts:          make(map[uint64]*entity.BudgetAlert),
		alertsSentToday: make(map[string]bool),
	}
	notifier := &mockNotificationService{}
	logger := logrus.New()

	service := NewBudgetAlertService(budgetRepo, summaryRepo, alertRepo, notifier, logger)

	// 执行测试
	ctx := context.Background()
	err := service.CheckBudget(ctx, "tenant_test_001")

	// 验证结果
	require.NoError(t, err)
	assert.True(t, notifier.sendAlertCalled, "应该发送一级告警")
	require.Len(t, notifier.sentAlerts, 1, "应该有1条告警")

	alert := notifier.sentAlerts[0]
	assert.Equal(t, "tenant_test_001", alert.TenantID)
	assert.Equal(t, entity.AlertTypeThreshold1, alert.AlertType)
	assert.Equal(t, entity.AlertLevelWarning, alert.AlertLevel)
	assert.InDelta(t, 80.0, alert.UsagePercent, 0.1)
	assert.NotNil(t, alert.AlertMessage, "告警消息不应为空")
	assert.Contains(t, *alert.AlertMessage, "预算告警", "告警消息应包含标题")
}

func TestBudgetAlertService_CheckBudget_SecondThreshold(t *testing.T) {
	// 准备测试数据 - 使用率95%
	budget := &entity.BudgetSettings{
		TenantID:              "tenant_test_001",
		BudgetType:            entity.BudgetTypeMonthly,
		BudgetAmount:          1000.0,
		HardCapEnabled:        true,
		AlertThreshold1:       80,
		AlertThreshold2:       95,
		NotificationChannels:  `["email", "sms"]`,
	}

	budgetRepo := &mockBudgetSettingsRepository{budgets: map[string]*entity.BudgetSettings{
		"tenant_test_001": budget,
	}}
	summaryRepo := &mockTokenUsageSummaryRepository{totalCost: 950.0} // 95%
	alertRepo := &mockBudgetAlertRepository{
		alerts:          make(map[uint64]*entity.BudgetAlert),
		alertsSentToday: make(map[string]bool),
	}
	notifier := &mockNotificationService{}
	logger := logrus.New()

	service := NewBudgetAlertService(budgetRepo, summaryRepo, alertRepo, notifier, logger)

	// 执行测试
	ctx := context.Background()
	err := service.CheckBudget(ctx, "tenant_test_001")

	// 验证结果
	require.NoError(t, err)
	require.Len(t, notifier.sentAlerts, 2, "应该有2条告警（80% + 95%）")

	// 验证二级告警
	criticalAlert := notifier.sentAlerts[1]
	assert.Equal(t, entity.AlertTypeThreshold2, criticalAlert.AlertType)
	assert.Equal(t, entity.AlertLevelCritical, criticalAlert.AlertLevel)
	assert.InDelta(t, 95.0, criticalAlert.UsagePercent, 0.1)
	assert.Contains(t, *criticalAlert.AlertMessage, "🚨", "紧急告警应包含emoji")
	assert.Contains(t, *criticalAlert.AlertMessage, "即将达到预算上限", "应包含警告信息")
}

func TestBudgetAlertService_CheckBudget_HardCapExceeded(t *testing.T) {
	// 准备测试数据 - 超过硬性上限
	hardCapAmount := 1000.0
	budget := &entity.BudgetSettings{
		TenantID:              "tenant_test_001",
		BudgetType:            entity.BudgetTypeMonthly,
		BudgetAmount:          1000.0,
		HardCapEnabled:        true,
		HardCapAmount:         &hardCapAmount,
		AlertThreshold1:       80,
		AlertThreshold2:       95,
		NotificationChannels:  `["email"]`,
		AutoDowngradeEnabled:  false, // 不启用降级，暂停服务
	}

	budgetRepo := &mockBudgetSettingsRepository{budgets: map[string]*entity.BudgetSettings{
		"tenant_test_001": budget,
	}}
	summaryRepo := &mockTokenUsageSummaryRepository{totalCost: 1001.0} // 超过硬性上限
	alertRepo := &mockBudgetAlertRepository{
		alerts:          make(map[uint64]*entity.BudgetAlert),
		alertsSentToday: make(map[string]bool),
	}
	notifier := &mockNotificationService{}
	logger := logrus.New()

	service := NewBudgetAlertService(budgetRepo, summaryRepo, alertRepo, notifier, logger)

	// 执行测试
	ctx := context.Background()
	err := service.CheckBudget(ctx, "tenant_test_001")

	// 验证结果
	require.NoError(t, err)

	// 应该有3条告警：threshold_1, threshold_2, hard_cap
	require.GreaterOrEqual(t, len(notifier.sentAlerts), 3, "应该至少有3条告警")

	// 验证硬性上限告警
	hardCapAlert := notifier.sentAlerts[len(notifier.sentAlerts)-1]
	assert.Equal(t, entity.AlertTypeHardCap, hardCapAlert.AlertType)
	assert.Equal(t, entity.AlertLevelEmergency, hardCapAlert.AlertLevel)
	assert.Contains(t, *hardCapAlert.AlertMessage, "🛑", "紧急告警应包含停止emoji")
	assert.Contains(t, *hardCapAlert.AlertMessage, "硬性上限触发", "应包含硬性上限信息")
	assert.Contains(t, *hardCapAlert.AlertMessage, "服务已暂停", "应包含服务暂停信息")
}

func TestBudgetAlertService_CheckBudget_AutoDowngrade(t *testing.T) {
	// 准备测试数据 - 启用自动降级
	hardCapAmount := 1000.0
	originalModel := "gpt-4"
	fallbackModel := "gpt-3.5-turbo"
	budget := &entity.BudgetSettings{
		TenantID:              "tenant_test_001",
		BudgetType:            entity.BudgetTypeMonthly,
		BudgetAmount:          1000.0,
		HardCapEnabled:        true,
		HardCapAmount:         &hardCapAmount,
		AutoDowngradeEnabled:  true,  // 启用自动降级
		OriginalModel:         &originalModel,
		FallbackModel:         &fallbackModel,
		NotificationChannels:  `["email"]`,
	}

	budgetRepo := &mockBudgetSettingsRepository{budgets: map[string]*entity.BudgetSettings{
		"tenant_test_001": budget,
	}}
	summaryRepo := &mockTokenUsageSummaryRepository{totalCost: 1001.0}
	alertRepo := &mockBudgetAlertRepository{
		alerts:          make(map[uint64]*entity.BudgetAlert),
		alertsSentToday: make(map[string]bool),
	}
	notifier := &mockNotificationService{}
	logger := logrus.New()

	service := NewBudgetAlertService(budgetRepo, summaryRepo, alertRepo, notifier, logger)

	// 执行测试
	ctx := context.Background()
	err := service.CheckBudget(ctx, "tenant_test_001")

	// 验证结果
	require.NoError(t, err)

	// 应该有4条告警：threshold_1, threshold_2, hard_cap, downgrade
	require.GreaterOrEqual(t, len(notifier.sentAlerts), 4, "应该至少有4条告警")

	// 验证降级告警
	downgradeAlert := notifier.sentAlerts[len(notifier.sentAlerts)-1]
	assert.Equal(t, entity.AlertTypeDowngrade, downgradeAlert.AlertType)
	assert.Equal(t, entity.AlertLevelWarning, downgradeAlert.AlertLevel)
	assert.Contains(t, *downgradeAlert.AlertMessage, "自动降级已触发", "应包含降级信息")
	assert.Contains(t, *downgradeAlert.AlertMessage, originalModel, "应包含原模型名称")
	assert.Contains(t, *downgradeAlert.AlertMessage, fallbackModel, "应包含降级模型名称")
}

func TestBudgetAlertService_CheckBudget_AlertDeduplication(t *testing.T) {
	// 准备测试数据 - 测试告警去重
	today := time.Now().Format("2006-01-02")
	budget := &entity.BudgetSettings{
		TenantID:              "tenant_test_001",
		BudgetType:            entity.BudgetTypeMonthly,
		BudgetAmount:          1000.0,
		HardCapEnabled:        true,
		AlertThreshold1:       80,
		AlertThreshold2:       95,
		NotificationChannels:  `["email"]`,
	}

	budgetRepo := &mockBudgetSettingsRepository{budgets: map[string]*entity.BudgetSettings{
		"tenant_test_001": budget,
	}}
	summaryRepo := &mockTokenUsageSummaryRepository{totalCost: 800.0}
	alertRepo := &mockBudgetAlertRepository{
		alerts:          make(map[uint64]*entity.BudgetAlert),
		alertsSentToday: map[string]bool{
			"tenant_test_001:threshold_1:" + today: true, // 今天已发送过一级告警
		},
	}
	notifier := &mockNotificationService{}
	logger := logrus.New()

	service := NewBudgetAlertService(budgetRepo, summaryRepo, alertRepo, notifier, logger)

	// 执行测试
	ctx := context.Background()
	err := service.CheckBudget(ctx, "tenant_test_001")

	// 验证结果
	require.NoError(t, err)
	assert.False(t, notifier.sendAlertCalled, "今天已发送过相同类型告警，不应重复发送")
}

