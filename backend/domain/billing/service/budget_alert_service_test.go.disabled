func TestBudgetAlertService_CheckBudget_RepositoryErrors(t *testing.T) {
	tests := []struct {
		name        string
		setupBudget func() *mockBudgetSettingsRepository
		setupSummary func() *mockTokenUsageSummaryRepository
		expectError bool
	}{
		{
			name: "获取预算配置失败",
			setupBudget: func() *mockBudgetSettingsRepository {
				return &mockBudgetSettingsRepository{
					budgets: make(map[string]*entity.BudgetSettings),
					getErr:  assert.AnError,
				}
			},
			setupSummary: func() *mockTokenUsageSummaryRepository {
				return &mockTokenUsageSummaryRepository{}
			},
			expectError: true,
		},
		{
			name: "获取使用量汇总失败",
			setupBudget: func() *mockBudgetSettingsRepository {
				budget := &entity.BudgetSettings{
					TenantID:       "tenant_test_001",
					BudgetAmount:   1000.0,
					HardCapEnabled: true,
				}
				return &mockBudgetSettingsRepository{
					budgets: map[string]*entity.BudgetSettings{
						"tenant_test_001": budget,
					},
				}
			},
			setupSummary: func() *mockTokenUsageSummaryRepository {
				return &mockTokenUsageSummaryRepository{
					getErr: assert.AnError,
				}
			},
			expectError: true,
		},
	}

	for _, tt := range tests {
		t.Run(tt.name, func(t *testing.T) {
			budgetRepo := tt.setupBudget()
			summaryRepo := tt.setupSummary()
			alertRepo := &mockBudgetAlertRepository{alerts: make(map[uint64]*entity.BudgetAlert), alertsSentToday: make(map[string]bool)}
			notifier := &mockNotificationService{}
			logger := logrus.New()

			service := NewBudgetAlertService(budgetRepo, summaryRepo, alertRepo, notifier, logger)

			ctx := context.Background()
			err := service.CheckBudget(ctx, "tenant_test_001")

			if tt.expectError {
				assert.Error(t, err, tt.name+"应该返回错误")
			} else {
				assert.NoError(t, err, tt.name+"不应返回错误")
			}
		})
	}
}

func TestBudgetAlertService_CheckBudgetsForAllTenants(t *testing.T) {
	// 准备测试数据 - 多个租户
	hardCapAmount := 1000.0
	budget1 := &entity.BudgetSettings{
		TenantID:       "tenant_001",
		BudgetAmount:   1000.0,
		HardCapEnabled: true,
		AlertThreshold1: 80,
		AlertThreshold2: 95,
	}
	budget2 := &entity.BudgetSettings{
		TenantID:       "tenant_002",
		BudgetAmount:   2000.0,
		HardCapEnabled: true,
		AlertThreshold1: 80,
		AlertThreshold2: 95,
	}
	budget3 := &entity.BudgetSettings{
		TenantID:       "tenant_003",
		BudgetAmount:   3000.0,
		HardCapEnabled: false, // 未启用硬性上限
	}

	budgetRepo := &mockBudgetSettingsRepository{budgets: map[string]*entity.BudgetSettings{
		"tenant_001": budget1,
		"tenant_002": budget2,
		"tenant_003": budget3,
	}}

	// Mock summary repo - 为每个租户返回不同的使用量
	summaryRepo := &mockTokenUsageSummaryRepository{
		totalCost: 850.0, // 85% for tenant_001 (会触发告警)
	}

	alertRepo := &mockBudgetAlertRepository{
		alerts:          make(map[uint64]*entity.BudgetAlert),
		alertsSentToday: make(map[string]bool),
	}
	notifier := &mockNotificationService{}
	logger := logrus.New()

	service := NewBudgetAlertService(budgetRepo, summaryRepo, alertRepo, notifier, logger)

	// 执行测试
	ctx := context.Background()
	err := service.CheckBudgetsForAllTenants(ctx)

	// 验证结果
	require.NoError(t, err)
	// tenant_001 和 tenant_002 会触发告警，tenant_003 不会（未启用硬性上限）
	// 这里不验证具体数量，因为每个租户使用相同的totalCost
	assert.NotEmpty(t, notifier.sentAlerts, "应该有告警被发送")
}

func TestBudgetAlertService_buildAlertMessage(t *testing.T) {
	// 准备测试数据
	budget := &entity.BudgetSettings{
		TenantID:     "tenant_test_001",
		BudgetAmount: 1000.0,
	}

	tests := []struct {
		name         string
		usedAmount   float64
		usagePercent decimal.Decimal
		alertLevel   string
		expectEmoji  string
		expectText   string
	}{
		{
			name:         "Warning级别",
			usedAmount:   800.0,
			usagePercent: decimal.NewFromInt(80),
			alertLevel:   entity.AlertLevelWarning,
			expectEmoji:  "⚠️",
			expectText:   "请注意控制使用量",
		},
		{
			name:         "Critical级别",
			usedAmount:   950.0,
			usagePercent: decimal.NewFromInt(95),
			alertLevel:   entity.AlertLevelCritical,
			expectEmoji:  "🚨",
			expectText:   "即将达到预算上限",
		},
		{
			name:         "Emergency级别",
			usedAmount:   1000.0,
			usagePercent: decimal.NewFromInt(100),
			alertLevel:   entity.AlertLevelEmergency,
			expectEmoji:  "🛑",
			expectText:   "服务已暂停或降级",
		},
	}

	for _, tt := range tests {
		t.Run(tt.name, func(t *testing.T) {
			logger := logrus.New()
			service := &BudgetAlertService{logger: logger}

			// 调用内部方法（通过反射或测试公开方法）
			// 这里我们直接测试，因为它是一个公开的辅助方法（如果需要的话，可以将其设为公开）
			// 由于buildAlertMessage是私有方法，我们通过CheckBudget间接测试

			alertRepo := &mockBudgetAlertRepository{alerts: make(map[uint64]*entity.BudgetAlert), alertsSentToday: make(map[string]bool)}
			budgetRepo := &mockBudgetSettingsRepository{budgets: map[string]*entity.BudgetSettings{
				"tenant_test_001": budget,
			}}

			// 模拟相应的使用率
			summaryRepo := &mockTokenUsageSummaryRepository{totalCost: tt.usedAmount}
			notifier := &mockNotificationService{}

			service = NewBudgetAlertService(budgetRepo, summaryRepo, alertRepo, notifier, logger)

			// 执行测试 - 触发告警以生成消息
			ctx := context.Background()
			_ = service.CheckBudget(ctx, "tenant_test_001")

			// 验证告警消息
			require.NotEmpty(t, notifier.sentAlerts, "应该有告警")
			message := notifier.sentAlerts[0].AlertMessage
			require.NotNil(t, message, "告警消息不应为空")
			assert.Contains(t, *message, tt.expectEmoji, "应包含正确的emoji")
			assert.Contains(t, *message, tt.expectText, "应包含正确的提示文本")
			assert.Contains(t, *message, "tenant_test_001", "应包含租户ID")
			assert.Contains(t, *message, "1000.00", "应包含预算金额")
		})
	}
}

func TestBudgetAlertService_NotificationChannelsParsing(t *testing.T) {
	// 准备测试数据
	tests := []struct {
		name                 string
		channels             string
		expectChannelCount   int
	}{
		{
			name:                 "单渠道 - email",
			channels:             `["email"]`,
			expectChannelCount:   1,
		},
		{
			name:                 "多渠道",
			channels:             `["email", "sms", "webhook"]`,
			expectChannelCount:   3,
		},
		{
			name:                 "空字符串 - 默认email",
			channels:             "",
			expectChannelCount:   1,
		},
		{
			name:                 "无效JSON - 默认email",
			channels:             "invalid json",
			expectChannelCount:   1,
		},
	}

	for _, tt := range tests {
		t.Run(tt.name, func(t *testing.T) {
			hardCapAmount := 1000.0
			budget := &entity.BudgetSettings{
				TenantID:             "tenant_test_001",
				BudgetAmount:         1000.0,
				HardCapEnabled:       true,
				HardCapAmount:        &hardCapAmount,
				NotificationChannels: tt.channels,
			}

			budgetRepo := &mockBudgetSettingsRepository{budgets: map[string]*entity.BudgetSettings{
				"tenant_test_001": budget,
			}}
			summaryRepo := &mockTokenUsageSummaryRepository{totalCost: 1001.0}
			alertRepo := &mockBudgetAlertRepository{alerts: make(map[uint64]*entity.BudgetAlert), alertsSentToday: make(map[string]bool)}
			notifier := &mockNotificationService{}
			logger := logrus.New()

			service := NewBudgetAlertService(budgetRepo, summaryRepo, alertRepo, notifier, logger)

			// 执行测试
			ctx := context.Background()
			_ = service.CheckBudget(ctx, "tenant_test_001")

			// 验证 - 检查通知渠道是否被正确设置
			require.NotEmpty(t, notifier.sentAlerts, "应该有告警")

			// 解析通知渠道验证
			var channels []string
			if tt.channels != "" {
				err := json.Unmarshal([]byte(tt.channels), &channels)
				if err != nil {
					channels = []string{"email"} // 默认
				}
			} else {
				channels = []string{"email"}
			}

			// 验证告警对象中的通知渠道设置
			alert := notifier.sentAlerts[0]
			var parsedChannels []string
			if alert.NotificationChannels != "" {
				_ = json.Unmarshal([]byte(alert.NotificationChannels), &parsedChannels)
			}
			assert.Len(t, parsedChannels, len(channels), "通知渠道数量应匹配")
		})
	}
}

func TestBudgetAlertService_AutoDowngradeWithoutModels(t *testing.T) {
	// 测试自动降级启用但未配置模型的情况
	hardCapAmount := 1000.0
	budget := &entity.BudgetSettings{
		TenantID:             "tenant_test_001",
		BudgetAmount:         1000.0,
		HardCapEnabled:       true,
		HardCapAmount:        &hardCapAmount,
		AutoDowngradeEnabled: true, // 启用降级但未配置模型
		OriginalModel:        nil,
		FallbackModel:        nil,
		NotificationChannels: `["email"]`,
	}

	budgetRepo := &mockBudgetSettingsRepository{budgets: map[string]*entity.BudgetSettings{
		"tenant_test_001": budget,
	}}
	summaryRepo := &mockTokenUsageSummaryRepository{totalCost: 1001.0}
	alertRepo := &mockBudgetAlertRepository{alerts: make(map[uint64]*entity.BudgetAlert), alertsSentToday: make(map[string]bool)}
	notifier := &mockNotificationService{}
	logger := logrus.New()

	service := NewBudgetAlertService(budgetRepo, summaryRepo, alertRepo, notifier, logger)

	// 执行测试 - 不应panic
	ctx := context.Background()
	err := service.CheckBudget(ctx, "tenant_test_001")

	// 验证结果
	require.NoError(t, err, "不应返回错误")

	// 应该有硬性上限告警，但不应该有降级告警（因为未配置模型）
	hasDowngradeAlert := false
	for _, alert := range notifier.sentAlerts {
		if alert.AlertType == entity.AlertTypeDowngrade {
			hasDowngradeAlert = true
			break
		}
	}
	assert.False(t, hasDowngradeAlert, "未配置模型时不应发送降级告警")
}

