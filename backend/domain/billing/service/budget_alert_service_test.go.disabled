// mockBudgetSettingsRepository 模拟预算配置仓储
type mockBudgetSettingsRepository struct {
	budgets map[string]*entity.BudgetSettings
	getErr  error
	listErr error
}

func (m *mockBudgetSettingsRepository) GetByTenantID(ctx context.Context, tenantID string) (*entity.BudgetSettings, error) {
	if m.getErr != nil {
		return nil, m.getErr
	}
	return m.budgets[tenantID], nil
}

func (m *mockBudgetSettingsRepository) Create(ctx context.Context, budget *entity.BudgetSettings) error {
	m.budgets[budget.TenantID] = budget
	return nil
}

func (m *mockBudgetSettingsRepository) Update(ctx context.Context, budget *entity.BudgetSettings) error {
	m.budgets[budget.TenantID] = budget
	return nil
}

func (m *mockBudgetSettingsRepository) Delete(ctx context.Context, tenantID string) error {
	delete(m.budgets, tenantID)
	return nil
}

func (m *mockBudgetSettingsRepository) List(ctx context.Context, filter *BudgetSettingsFilter) ([]*entity.BudgetSettings, *string, error) {
	if m.listErr != nil {
		return nil, nil, m.listErr
	}
	var result []*entity.BudgetSettings
	for _, budget := range m.budgets {
		result = append(result, budget)
	}
	return result, nil, nil
}

// mockTokenUsageSummaryRepository 模拟使用量汇总仓储
type mockTokenUsageSummaryRepository struct {
	totalCost float64
	getErr    error
}

func (m *mockTokenUsageSummaryRepository) GetTotalCost(ctx context.Context, tenantID string, startDate, endDate time.Time) (float64, error) {
	if m.getErr != nil {
		return 0, m.getErr
	}
	return m.totalCost, nil
}

func (m *mockTokenUsageSummaryRepository) Upsert(ctx context.Context, summary *entity.TokenUsageSummary) error {
	return nil
}

func (m *mockTokenUsageSummaryRepository) GetByDateRange(ctx context.Context, tenantID string, botID *string, startDate, endDate time.Time) ([]*entity.TokenUsageSummary, error) {
	return nil, nil
}

func (m *mockTokenUsageSummaryRepository) GetByTenant(ctx context.Context, tenantID string, status *string, limit int) ([]*entity.TokenUsageSummary, error) {
	return nil, nil
}

func (m *mockTokenUsageSummaryRepository) GetDailyCosts(ctx context.Context, tenantID string, startDate, endDate time.Time) (map[string]float64, error) {
	return nil, nil
}

// mockBudgetAlertRepository 模拟告警仓储
type mockBudgetAlertRepository struct {
	alerts          map[uint64]*entity.BudgetAlert
	alertsSentToday map[string]bool // key: tenantID + alertType + date
	createErr       error
	checkErr        error
}

func (m *mockBudgetAlertRepository) Create(ctx context.Context, alert *entity.BudgetAlert) error {
	if m.createErr != nil {
		return m.createErr
	}
	alert.ID = uint64(len(m.alerts) + 1)
	m.alerts[alert.ID] = alert
	return nil
}

func (m *mockBudgetAlertRepository) GetByTenant(ctx context.Context, tenantID string, alertType *string, limit int) ([]*entity.BudgetAlert, error) {
	var result []*entity.BudgetAlert
	for _, alert := range m.alerts {
		if alert.TenantID == tenantID {
			result = append(result, alert)
		}
	}
	return result, nil
}

func (m *mockBudgetAlertRepository) CheckAlertSentToday(ctx context.Context, tenantID, alertType, today string) (bool, error) {
	if m.checkErr != nil {
		return false, m.checkErr
	}
	key := tenantID + ":" + alertType + ":" + today
	return m.alertsSentToday[key], nil
}

func (m *mockBudgetAlertRepository) UpdateNotificationStatus(ctx context.Context, alertID uint64, status string, sentAt *time.Time, errMsg *string) error {
	if alert, ok := m.alerts[alertID]; ok {
		alert.NotificationStatus = status
		alert.SentAt = sentAt
		alert.ErrorMessage = errMsg
	}
	return nil
}

// mockNotificationService 模拟通知服务
type mockNotificationService struct {
	sendAlertCalled bool
	sendAlertErr    error
	sentAlerts      []*entity.BudgetAlert
}

func (m *mockNotificationService) SendAlert(ctx context.Context, alert *entity.BudgetAlert) error {
	m.sendAlertCalled = true
	m.sentAlerts = append(m.sentAlerts, alert)
	return m.sendAlertErr
}

