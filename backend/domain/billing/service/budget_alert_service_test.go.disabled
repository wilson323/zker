		"tenant_test_001": budget,
	}}
	summaryRepo := &mockTokenUsageSummaryRepository{totalCost: 2400.0} // 80%
	alertRepo := &mockBudgetAlertRepository{
		alerts:          make(map[uint64]*entity.BudgetAlert),
		alertsSentToday: make(map[string]bool),
	}
	notifier := &mockNotificationService{}
	logger := logrus.New()

	service := NewBudgetAlertService(budgetRepo, summaryRepo, alertRepo, notifier, logger)

	// 执行测试
	ctx := context.Background()
	err := service.CheckBudget(ctx, "tenant_test_001")

	// 验证结果
	require.NoError(t, err)
	assert.True(t, notifier.sendAlertCalled, "应该发送季度预算告警")
}

