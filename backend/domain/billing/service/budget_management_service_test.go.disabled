// TestBudgetManagementService_CheckBudget 测试预算检查
func TestBudgetManagementService_CheckBudget(t *testing.T) {
	mockBudgetRepo := new(MockBudgetSettingsRepository)
	mockAlertRepo := new(MockBudgetAlertRepository)
	mockSummaryRepo := new(MockTokenUsageSummaryRepository)

	ctx := context.Background()
	tenantID := "tenant-001"

	budget := &entity.BudgetSettings{
		TenantID:        tenantID,
		BudgetType:      entity.BudgetTypeMonthly,
		BudgetAmount:    10000.00,
		AlertThreshold1: 80,
		AlertThreshold2: 95,
		HardCapEnabled:  false,
	}

	now := time.Now()
	startDate := time.Date(now.Year(), now.Month(), 1, 0, 0, 0, 0, now.Location())

	// Mock配置
	mockBudgetRepo.On("GetByTenantID", ctx, tenantID).Return(budget, nil)
	mockSummaryRepo.On("GetTotalCost", ctx, tenantID, startDate, mock.AnythingOfType("time.Time")).Return(8500.00, nil)

	// 创建服务
	service := NewBudgetManagementService(mockBudgetRepo, mockAlertRepo, mockSummaryRepo, nil, nil)

	// 执行测试
	result, err := service.CheckBudget(ctx, tenantID)

	// 断言
	require.NoError(t, err)
	require.NotNil(t, result)
	assert.Equal(t, tenantID, result.TenantID)
	assert.Equal(t, 10000.00, result.BudgetAmount)
	assert.Equal(t, 8500.00, result.UsedAmount)
	assert.Equal(t, 85.0, result.UsagePercent)
	assert.True(t, result.AlertTriggered)
	assert.NotNil(t, result.AlertLevel)
	assert.Equal(t, entity.AlertLevelCritical, *result.AlertLevel)

	// 验证Mock调用
	mockBudgetRepo.AssertExpectations(t)
	mockSummaryRepo.AssertExpectations(t)
}

// TestBudgetManagementService_GetBudgetUsage 测试获取预算使用情况
func TestBudgetManagementService_GetBudgetUsage(t *testing.T) {
	mockBudgetRepo := new(MockBudgetSettingsRepository)
	mockAlertRepo := new(MockBudgetAlertRepository)
	mockSummaryRepo := new(MockTokenUsageSummaryRepository)

	ctx := context.Background()
	tenantID := "tenant-001"

	channelsJSON, _ := json.Marshal([]string{"email"})
	recipientsJSON, _ := json.Marshal([]string{"admin@example.com"})

	budget := &entity.BudgetSettings{
		TenantID:               tenantID,
		BudgetType:             entity.BudgetTypeMonthly,
		BudgetAmount:           10000.00,
		Currency:               "CNY",
		AlertThreshold1:        80,
		AlertThreshold2:        95,
		HardCapEnabled:         false,
		NotificationChannels:   string(channelsJSON),
		NotificationRecipients: string(recipientsJSON),
	}

	now := time.Now()
	summaries := []*entity.TokenUsageSummary{
		{
			TotalTokens:     1000000,
			TotalRequests:   100,
			TotalCost:       500.00,
		},
	}

	alerts := []*entity.BudgetAlert{
		{
			ID:         1,
			AlertLevel: entity.AlertLevelWarning,
			CreatedAt:  now,
		},
	}

	// Mock配置
	mockBudgetRepo.On("GetByTenantID", ctx, tenantID).Return(budget, nil)
	mockSummaryRepo.On("GetByDateRange", ctx, tenantID, nil, mock.AnythingOfType("string"), mock.AnythingOfType("string")).Return(summaries, nil)
	mockAlertRepo.On("GetByTenant", ctx, tenantID, 100).Return(alerts, nil)

	// 创建服务
	service := NewBudgetManagementService(mockBudgetRepo, mockAlertRepo, mockSummaryRepo, nil, nil)

	// 执行测试
	result, err := service.GetBudgetUsage(ctx, tenantID)

	// 断言
	require.NoError(t, err)
	require.NotNil(t, result)
	assert.Equal(t, 10000.00, result.BudgetAmount)
	assert.Equal(t, 500.00, result.UsedAmount)
	assert.Equal(t, 9500.00, result.RemainingAmount)
	assert.Equal(t, 5.0, result.UsagePercent)
	assert.Equal(t, int64(1000000), result.TotalTokens)
	assert.Equal(t, 100, result.TotalRequests)
	assert.Equal(t, 1, result.AlertCount)
	assert.NotNil(t, result.LastAlertAt)
	assert.NotNil(t, result.LastAlertLevel)

	// 验证Mock调用
	mockBudgetRepo.AssertExpectations(t)
	mockSummaryRepo.AssertExpectations(t)
	mockAlertRepo.AssertExpectations(t)
}

// TestBudgetManagementService_GetAlerts 测试获取告警历史
func TestBudgetManagementService_GetAlerts(t *testing.T) {
	mockBudgetRepo := new(MockBudgetSettingsRepository)
	mockAlertRepo := new(MockBudgetAlertRepository)
	mockSummaryRepo := new(MockTokenUsageSummaryRepository)

	ctx := context.Background()
	tenantID := "tenant-001"

	alerts := []*entity.BudgetAlert{
		{
			ID:                  1,
			TenantID:            tenantID,
			AlertType:           entity.AlertTypeThreshold1,
			BudgetAmount:        10000.00,
			UsedAmount:          8500.00,
			UsagePercent:        85.0,
			AlertLevel:          entity.AlertLevelWarning,
			NotificationChannels: `["email"]`,
			NotificationStatus:  entity.NotificationStatusSent,
			CreatedAt:           time.Now(),
		},
	}

	// Mock配置
	mockAlertRepo.On("List", ctx, mock.MatchedBy(func(f *repository.BudgetAlertFilter) bool {
		return f.TenantID == tenantID && f.PageSize == 20
	})).Return(alerts, int64(1), nil)

	// 创建服务
	service := NewBudgetManagementService(mockBudgetRepo, mockAlertRepo, mockSummaryRepo, nil, nil)

	// 执行测试
	reqFilter := &AlertFilter{
		PageSize: 20,
	}
	result, pagination, err := service.GetAlerts(ctx, tenantID, reqFilter)

	// 断言
	require.NoError(t, err)
	require.NotNil(t, result)
	assert.Len(t, result, 1)
	assert.Equal(t, uint64(1), result[0].ID)
	assert.Equal(t, tenantID, result[0].TenantID)
	assert.Equal(t, entity.AlertTypeThreshold1, result[0].AlertType)
	assert.NotNil(t, pagination)
	assert.Equal(t, int64(1), pagination.TotalCount)

	// 验证Mock调用
	mockAlertRepo.AssertExpectations(t)
}
