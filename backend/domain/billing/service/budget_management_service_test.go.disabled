// TestBudgetManagementService_GetBudget 测试获取预算配置
func TestBudgetManagementService_GetBudget(t *testing.T) {
	// 准备测试数据
	mockBudgetRepo := new(MockBudgetSettingsRepository)
	mockAlertRepo := new(MockBudgetAlertRepository)
	mockSummaryRepo := new(MockTokenUsageSummaryRepository)

	ctx := context.Background()
	tenantID := "tenant-001"

	// 构建预期的预算配置
	channelsJSON, _ := json.Marshal([]string{"email", "webhook"})
	recipientsJSON, _ := json.Marshal([]string{"admin@example.com"})

	expectedBudget := &entity.BudgetSettings{
		ID:                     1,
		TenantID:               tenantID,
		BudgetType:             entity.BudgetTypeMonthly,
		BudgetAmount:           10000.00,
		Currency:               "CNY",
		AlertThreshold1:        80,
		AlertThreshold2:        95,
		HardCapEnabled:         true,
		HardCapAmount:          float64Ptr(12000.00),
		AutoDowngradeEnabled:   false,
		DowngradeThreshold:     90,
		NotificationChannels:   string(channelsJSON),
		NotificationRecipients: string(recipientsJSON),
		CreatedAt:              time.Now(),
		UpdatedAt:              time.Now(),
	}

	// 设置Mock期望
	mockBudgetRepo.On("GetByTenantID", ctx, tenantID).Return(expectedBudget, nil)

	// 创建服务
	service := NewBudgetManagementService(mockBudgetRepo, mockAlertRepo, mockSummaryRepo, nil, nil)

	// 执行测试
	result, err := service.GetBudget(ctx, tenantID)

	// 断言
	require.NoError(t, err)
	require.NotNil(t, result)
	assert.Equal(t, tenantID, result.TenantID)
	assert.Equal(t, entity.BudgetTypeMonthly, result.BudgetType)
	assert.Equal(t, 10000.00, result.BudgetAmount)
	assert.Equal(t, "CNY", result.Currency)
	assert.Equal(t, 80, result.AlertThreshold1)
	assert.Equal(t, 95, result.AlertThreshold2)
	assert.True(t, result.HardCapEnabled)
	assert.NotNil(t, result.HardCapAmount)
	assert.Equal(t, 12000.00, *result.HardCapAmount)
	assert.Equal(t, []string{"email", "webhook"}, result.NotificationChannels)
	assert.Equal(t, []string{"admin@example.com"}, result.NotificationRecipients)

	// 验证Mock调用
	mockBudgetRepo.AssertExpectations(t)
}

// TestBudgetManagementService_CreateBudget 测试创建预算配置
func TestBudgetManagementService_CreateBudget(t *testing.T) {
	mockBudgetRepo := new(MockBudgetSettingsRepository)
	mockAlertRepo := new(MockBudgetAlertRepository)
	mockSummaryRepo := new(MockTokenUsageSummaryRepository)

	ctx := context.Background()

	req := &CreateBudgetRequest{
		TenantID:              "tenant-001",
		BudgetType:            entity.BudgetTypeMonthly,
		BudgetAmount:          10000.00,
		Currency:              "CNY",
		AlertThreshold1:       80,
		AlertThreshold2:       95,
		HardCapEnabled:        true,
		HardCapAmount:         float64Ptr(12000.00),
		AutoDowngradeEnabled:  false,
		DowngradeThreshold:    90,
		NotificationChannels:  []string{"email", "webhook"},
		NotificationRecipients: []string{"admin@example.com"},
	}

	// 模拟预算不存在
	mockBudgetRepo.On("GetByTenantID", ctx, req.TenantID).Return(nil, gorm.ErrRecordNotFound)

	// 模拟创建成功
	mockBudgetRepo.On("Create", ctx, mock.AnythingOfType("*entity.BudgetSettings")).Return(nil)

	// 创建服务
	service := NewBudgetManagementService(mockBudgetRepo, mockAlertRepo, mockSummaryRepo, nil, nil)

	// 执行测试
	result, err := service.CreateBudget(ctx, req)

	// 断言
	require.NoError(t, err)
	require.NotNil(t, result)
	assert.Equal(t, req.TenantID, result.TenantID)
	assert.Equal(t, req.BudgetType, result.BudgetType)
	assert.Equal(t, req.BudgetAmount, result.BudgetAmount)

	// 验证Mock调用
	mockBudgetRepo.AssertExpectations(t)
}

// TestBudgetManagementService_CreateBudget_AlreadyExists 测试创建已存在的预算
func TestBudgetManagementService_CreateBudget_AlreadyExists(t *testing.T) {
	mockBudgetRepo := new(MockBudgetSettingsRepository)
	mockAlertRepo := new(MockBudgetAlertRepository)
	mockSummaryRepo := new(MockTokenUsageSummaryRepository)

	ctx := context.Background()
	tenantID := "tenant-001"

	req := &CreateBudgetRequest{
		TenantID:              tenantID,
		BudgetType:            entity.BudgetTypeMonthly,
		BudgetAmount:          10000.00,
		Currency:              "CNY",
		AlertThreshold1:       80,
		AlertThreshold2:       95,
		HardCapEnabled:        false,
		AutoDowngradeEnabled:  false,
		DowngradeThreshold:    90,
		NotificationChannels:  []string{"email"},
		NotificationRecipients: []string{"admin@example.com"},
	}

	existingBudget := &entity.BudgetSettings{
		TenantID: tenantID,
	}

	// 模拟预算已存在
	mockBudgetRepo.On("GetByTenantID", ctx, tenantID).Return(existingBudget, nil)

	// 创建服务
	service := NewBudgetManagementService(mockBudgetRepo, mockAlertRepo, mockSummaryRepo, nil, nil)

	// 执行测试
	result, err := service.CreateBudget(ctx, req)

	// 断言
	require.Error(t, err)
	assert.Nil(t, result)
	assert.Contains(t, err.Error(), "already exists")

	// 验证Mock调用
	mockBudgetRepo.AssertExpectations(t)
}

// TestBudgetManagementService_UpdateBudget 测试更新预算配置
func TestBudgetManagementService_UpdateBudget(t *testing.T) {
	mockBudgetRepo := new(MockBudgetSettingsRepository)
	mockAlertRepo := new(MockBudgetAlertRepository)
	mockSummaryRepo := new(MockTokenUsageSummaryRepository)

	ctx := context.Background()
	tenantID := "tenant-001"

	newAmount := 15000.00
	req := &UpdateBudgetRequest{
		BudgetAmount: &newAmount,
	}

	existingBudget := &entity.BudgetSettings{
		ID:                     1,
		TenantID:               tenantID,
		BudgetType:             entity.BudgetTypeMonthly,
		BudgetAmount:           10000.00,
		Currency:               "CNY",
		AlertThreshold1:        80,
		AlertThreshold2:        95,
		HardCapEnabled:         true,
		NotificationChannels:   `["email"]`,
		NotificationRecipients: `["admin@example.com"]`,
	}

	// 模拟获取现有配置
	mockBudgetRepo.On("GetByTenantID", ctx, tenantID).Return(existingBudget, nil)

	// 模拟更新成功
	mockBudgetRepo.On("Update", ctx, mock.AnythingOfType("*entity.BudgetSettings")).Return(nil)

	// 创建服务
	service := NewBudgetManagementService(mockBudgetRepo, mockAlertRepo, mockSummaryRepo, nil, nil)

	// 执行测试
	result, err := service.UpdateBudget(ctx, tenantID, req)

	// 断言
	require.NoError(t, err)
	require.NotNil(t, result)
	assert.Equal(t, newAmount, result.BudgetAmount)

	// 验证Mock调用
	mockBudgetRepo.AssertExpectations(t)
}

