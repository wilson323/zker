# ========================================
# 组织中心 (Organization Center) - 生产环境配置
# 环境名称: Production (生产环境)
# 用途: 生产环境，提供对外服务
# ========================================

# ========== 应用配置 ==========
APP_ENV=production
APP_LOG_LEVEL=warn  # 生产环境使用 warn 级别
APP_PORT=8080
APP_NAME="Organization Center API"
APP_VERSION=${APP_VERSION}  # 从 CI/CD 注入

# ========== 服务器配置 ==========
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
SERVER_READ_TIMEOUT=60s
SERVER_WRITE_TIMEOUT=60s
SERVER_SHUTDOWN_TIMEOUT=30s
SERVER_MAX_HEADER_BYTES=1048576  # 1MB

# ========== 数据库配置 (MySQL) ==========
DB_HOST=mysql-prod.prod.svc.cluster.local
DB_PORT=3306
DB_USER=org_center_app
DB_PASSWORD=${DB_PASSWORD}  # 从 Secret 读取
DB_NAME=org_center
DB_MAX_IDLE_CONNS=20
DB_MAX_OPEN_CONNS=100
DB_CONN_MAX_LIFETIME=2h
DB_CONN_MAX_IDLE_TIME=10m
DB_LOG_LEVEL=error  # 生产环境仅记录错误

# 主从配置（读写分离）
DB_READ_REPLICA_HOSTS=mysql-read-replica-prod.prod.svc.cluster.local
DB_READ_REPLICA_PORT=3306
DB_READ_REPLICA_USER=org_center_readonly
DB_READ_REPLICA_PASSWORD=${DB_READ_REPLICA_PASSWORD}
DB_ENABLE_READ_REPLICA=true
DB_READ_REPLICA_WEIGHT=0.8  # 80% 读操作走从库

# 连接池配置
DB_CONNECT_TIMEOUT=10s
DB_READ_TIMEOUT=30s
DB_WRITE_TIMEOUT=30s

# ========== Redis 配置 ==========
REDIS_HOST=redis-prod.prod.svc.cluster.local
REDIS_PORT=6379
REDIS_PASSWORD=${REDIS_PASSWORD}  # 从 Secret 读取
REDIS_DB=0
REDIS_POOL_SIZE=100
REDIS_MIN_IDLE_CONNS=20
REDIS_MAX_RETRIES=3
REDIS_DIAL_TIMEOUT=5s
REDIS_READ_TIMEOUT=3s
REDIS_WRITE_TIMEOUT=3s
REDIS_POOL_TIMEOUT=4s

# Redis Cluster 配置（如果使用集群）
REDIS_CLUSTER_ENABLED=false
REDIS_CLUSTER_ADDRESSES=redis-cluster-prod.prod.svc.cluster.local:6379

# ========== Elasticsearch 配置 ==========
ES_HOSTS=http://elasticsearch-prod.prod.svc.cluster.local:9200
ES_USERNAME=elastic
ES_PASSWORD=${ES_PASSWORD}
ES_INDEX_PREFIX=org_center
ES_MAXRetries=5
ES_MAXIdleConns=50
ES sniff=false  # 生产环境禁用自动嗅探

# ========== JWT 配置 ==========
JWT_SECRET=${JWT_SECRET}  # 从 Secret 读取，长度至少 32 字节
JWT_EXPIRE_TIME=4h  # 生产环境缩短 token 有效期
JWT_REFRESH_EXPIRE_TIME=168h  # 7 days
JWT_ISSUER=org-center-prod

# ========== 加密配置 ==========
ENCRYPTION_KEY=${ENCRYPTION_KEY}  # 从 Secret 读取，32 字节
AES_IV=${AES_IV}  # 从 Secret 读取，16 字节

# ========== CORS 配置 ==========
CORS_ENABLED=true
CORS_ALLOW_ORIGINS=https://org.example.com,https://www.example.com
CORS_ALLOW_METHODS=GET,POST,PUT,DELETE,OPTIONS,PATCH
CORS_ALLOW_HEADERS=Content-Type,Authorization,X-Requested-With,X-Client-ID,X-Request-ID
CORS_ALLOW_CREDENTIALS=true
CORS_MAX_AGE=3600

# ========== 限流配置 ==========
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_SECOND=2000
RATE_LIMIT_BURST=5000
RATE_LIMIT_ENABLED_PER_IP=true
RATE_LIMIT_IP_REQUESTS_PER_SECOND=100
RATE_LIMIT_IP_BURST=200
RATE_LIMIT_ENABLED_PER_USER=true
RATE_LIMIT_USER_REQUESTS_PER_SECOND=50
RATE_LIMIT_USER_BURST=100

# ========== 分页配置 ==========
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# ========== 文件上传配置 ==========
UPLOAD_ENABLED=true
UPLOAD_MAX_FILE_SIZE=104857600  # 100MB
UPLOAD_ALLOWED_EXTENSIONS=.jpg,.jpeg,.png,.gif,.pdf,.doc,.docx,.xls,.xlsx,.csv
UPLOAD_TEMP_DIR=/tmp/uploads
UPLOAD_MAX_FILES_PER_UPLOAD=10

# ========== MinIO 配置 ==========
MINIO_ENDPOINT=minio-prod.prod.svc.cluster.local:9000
MINIO_ACCESS_KEY=${MINIO_ACCESS_KEY}
MINIO_SECRET_KEY=${MINIO_SECRET_KEY}
MINIO_BUCKET=org-center
MINIO_USE_SSL=true
MINIO_REGION=us-east-1
MINIO_PART_SIZE=5242880  # 5MB

# ========== 消息队列配置 (NSQ) ==========
NSQ_LOOKUPD_ADDRESSES=nsqlookupd-prod.prod.svc.cluster.local:4161,nsqlookupd-prod-2.prod.svc.cluster.local:4161
NSQ_NSQD_ADDRESSES=nsqd-prod.prod.svc.cluster.local:4150,nsqd-prod-2.prod.svc.cluster.local:4150
NSQ_PRODUCER_TIMEOUT=15s
NSQ_CONSUMER_MAX_IN_FLIGHT=200
NSQ_CONSUMER_MAX_ATTEMPTS=10
NSQ_TLS_ENABLED=true
NSQ_TLS_INSECURE_SKIP_VERIFY=false

# ========== 监控配置 ==========
ENABLE_METRICS=true
METRICS_PORT=9090
METRICS_PATH=/metrics
ENABLE_PPROF=false  # 生产环境禁用 pprof

# ========== 分布式追踪配置 ==========
ENABLE_TRACING=true
JAEGER_ENDPOINT=http://jaeger-collector-prod.prod.svc.cluster.local:14268/api/traces
JAEGER_SAMPLER_TYPE=probabilistic
JAEGER_SAMPLER_PARAM=0.05  # 5% 采样，生产环境降低采样率
JAEGER_REPORTER_LOG_SPANS=false
JAEGER_TAGS=env:production,service:org-center

# ========== 日志配置 ==========
LOG_LEVEL=warn  # warn 和 error 级别
LOG_FORMAT=json  # JSON 格式便于解析
LOG_OUTPUT=stdout
LOG_FILE_PATH=/var/log/org-center/app.log
LOG_MAX_SIZE=500  # MB
LOG_MAX_BACKUPS=30
LOG_MAX_AGE=90  # days
LOG_COMPRESS=true

# ========== 功能开关 ==========
FEATURE_ENABLE_MULTI_TENANT=true
FEATURE_ENABLE_RBAC=true
FEATURE_ENABLE_AUDIT_LOG=true
FEATURE_ENABLE_API_CACHE=true
FEATURE_ENABLE_SWAGGER=false
FEATURE_ENABLE_MOCK_DATA=false

# ========== 第三方服务配置 ==========
# 邮件服务
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=noreply@example.com
SMTP_PASSWORD=${SMTP_PASSWORD}
SMTP_FROM=noreply@org-center
SMTP_INSECURE_SKIP_VERIFY=false

# 短信服务（阿里云）
SMS_ACCESS_KEY=${SMS_ACCESS_KEY}
SMS_ACCESS_SECRET=${SMS_ACCESS_SECRET}
SMS_SIGN_NAME=组织中心
SMS_TEMPLATE_CODE=SMS_987654321

# 对象存储（七牛云）
QINIU_ACCESS_KEY=${QINIU_ACCESS_KEY}
QINIU_SECRET_KEY=${QINIU_SECRET_KEY}
QINIU_BUCKET=org-center
QINIU_DOMAIN=https://cdn.example.com

# ========== 安全配置 ==========
SECURITY_ENABLE_HTTPS=true
SECURITY_ENABLE_CSRF=true
SECURITY_SESSION_TIMEOUT=3600  # seconds
SECURITY_PASSWORD_MIN_LENGTH=8
SECURITY_PASSWORD_REQUIRE_UPPERCASE=true
SECURITY_PASSWORD_REQUIRE_LOWERCASE=true
SECURITY_PASSWORD_REQUIRE_NUMBER=true
SECURITY_PASSWORD_REQUIRE_SPECIAL=true

# 内容安全（防 SQL 注入、XSS 等）
SECURITY_ENABLE_SQL_INJECTION_PROTECTION=true
SECURITY_ENABLE_XSS_PROTECTION=true
SECURITY_ENABLE_CONTENT_SECURITY_POLICY=true

# ========== 国际化配置 ==========
I18N_ENABLED=true
I18N_DEFAULT_LANGUAGE=zh-CN
I18N_SUPPORTED_LANGUAGES=zh-CN,en-US,ja-JP

# ========== 测试配置 ==========
TEST_ENABLED=false
TEST_MOCK_EXTERNAL_API=false
TEST_SEED_DATA=false

# ========== 调试配置 ==========
DEBUG_ENABLED=false  # 生产环境必须禁用
DEBUG_PPROF_ENABLED=false
DEBUG_VERBOSE_SQL=false
DEBUG_VERBOSE_REDIS=false
DEBUG_VERBOSE_HTTP=false

# ========== 性能优化配置 ==========
CACHE_ENABLED=true
CACHE_TTL=600  # 10 minutes
CACHE_MAX_ITEMS=100000
GC_TARGET_PERCENT=100
GOMAXPROCS=${GOMAXPROCS}  # 自动设置为 CPU 核心数

# ========== 高可用配置 ==========
HA_ENABLED=true
HA_HEALTH_CHECK_INTERVAL=10s
HA_HEALTH_CHECK_TIMEOUT=5s
HA_HEALTH_CHECK_RETRIES=3

# ========== 备份配置 ==========
BACKUP_ENABLED=true
BACKUP_RETENTION_DAYS=30
BACKUP_SCHEDULE=0 2 * * *  # 每天凌晨 2 点

# ========== 告警配置 ==========
ALERT_ENABLED=true
ALERT_WEBHOOK_URL=${ALERT_WEBHOOK_URL}
ALERT_EMAIL_TO=ops@example.com
ALERT_EMAIL_FROM=alerts@org-center

# ========== 合规配置 ==========
COMPLIANCE_ENABLE_GDPR=true
COMPLIANCE_ENABLE_DATA_RETENTION=true
COMPLIANCE_DATA_RETENTION_DAYS=365
COMPLIANCE_ENABLE_AUDIT_LOG=true

# ========================================
# 说明:
# 1. 此配置用于生产环境
# 2. 所有敏感信息（密码、密钥）必须通过 Kubernetes Secret 管理
# 3. 禁用所有调试功能（pprof、verbose 日志等）
# 4. 启用完整的安全配置（HTTPS、CSRF、CORS 等）
# 5. 降低追踪采样率（5%）以减少性能影响
# 6. 使用读写分离和连接池优化数据库性能
# 7. 启用高可用和备份配置
# 8. 遵守合规要求（GDPR、数据保留等）
# 9. 日志级别设置为 warn，减少日志量
# 10. 启用监控和告警
# ========================================

# ========== 使用方法 ==========
# 在 Kubernetes 中使用:
# kubectl create secret generic org-center-secret \
#   --from-literal=DB_PASSWORD='your-db-password' \
#   --from-literal=REDIS_PASSWORD='your-redis-password' \
#   --from-literal=JWT_SECRET='your-jwt-secret-min-32-bytes' \
#   --from-literal=ENCRYPTION_KEY='your-32-byte-encryption-key' \
#   --from-literal=SMS_ACCESS_KEY='your-sms-key' \
#   --from-literal=SMS_ACCESS_SECRET='your-sms-secret' \
#   -n org-center-prod
# ========================================
