# ========================================
# 组织中心 (Organization Center) - 预发布环境配置
# 环境名称: Staging (预发布/测试环境)
# 用途: 生产前测试、性能测试、集成测试
# ========================================

# ========== 应用配置 ==========
APP_ENV=staging
APP_LOG_LEVEL=info
APP_PORT=8080
APP_NAME="Organization Center API"
APP_VERSION="1.0.0"

# ========== 服务器配置 ==========
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
SERVER_READ_TIMEOUT=60s
SERVER_WRITE_TIMEOUT=60s
SERVER_SHUTDOWN_TIMEOUT=30s

# ========== 数据库配置 (MySQL) ==========
DB_HOST=mysql-staging.prod.svc.cluster.local
DB_PORT=3306
DB_USER=org_center_app
DB_PASSWORD=${DB_PASSWORD}  # 从 Secret 读取
DB_NAME=org_center_staging
DB_MAX_IDLE_CONNS=10
DB_MAX_OPEN_CONNS=50
DB_CONN_MAX_LIFETIME=1h
DB_CONN_MAX_IDLE_TIME=10m
DB_LOG_LEVEL=warn

# ========== Redis 配置 ==========
REDIS_HOST=redis-staging.prod.svc.cluster.local
REDIS_PORT=6379
REDIS_PASSWORD=${REDIS_PASSWORD}  # 从 Secret 读取
REDIS_DB=0
REDIS_POOL_SIZE=50
REDIS_MIN_IDLE_CONNS=10
REDIS_MAX_RETRIES=3
REDIS_DIAL_TIMEOUT=5s
REDIS_READ_TIMEOUT=3s
REDIS_WRITE_TIMEOUT=3s
REDIS_POOL_TIMEOUT=4s

# ========== Elasticsearch 配置 ==========
ES_HOSTS=http://elasticsearch-staging.prod.svc.cluster.local:9200
ES_USERNAME=elastic
ES_PASSWORD=${ES_PASSWORD}
ES_INDEX_PREFIX=org_center_staging
ES_MAXRetries=3
ES_MAXIdleConns=20

# ========== JWT 配置 ==========
JWT_SECRET=${JWT_SECRET}  # 从 Secret 读取，长度至少 32 字节
JWT_EXPIRE_TIME=8h
JWT_REFRESH_EXPIRE_TIME=168h  # 7 days
JWT_ISSUER=org-center-staging

# ========== 加密配置 ==========
ENCRYPTION_KEY=${ENCRYPTION_KEY}  # 从 Secret 读取，32 字节
AES_IV=${AES_IV}  # 从 Secret 读取，16 字节

# ========== CORS 配置 ==========
CORS_ENABLED=true
CORS_ALLOW_ORIGINS=https://staging-org.example.com,https://staging.example.com
CORS_ALLOW_METHODS=GET,POST,PUT,DELETE,OPTIONS,PATCH
CORS_ALLOW_HEADERS=Content-Type,Authorization,X-Requested-With,X-Client-ID
CORS_ALLOW_CREDENTIALS=true
CORS_MAX_AGE=3600

# ========== 限流配置 ==========
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_SECOND=1000
RATE_LIMIT_BURST=2000
RATE_LIMIT_ENABLED_PER_IP=true
RATE_LIMIT_IP_REQUESTS_PER_SECOND=100
RATE_LIMIT_IP_BURST=200

# ========== 分页配置 ==========
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# ========== 文件上传配置 ==========
UPLOAD_ENABLED=true
UPLOAD_MAX_FILE_SIZE=104857600  # 100MB
UPLOAD_ALLOWED_EXTENSIONS=.jpg,.jpeg,.png,.gif,.pdf,.doc,.docx,.xls,.xlsx,.csv
UPLOAD_TEMP_DIR=/tmp/uploads

# ========== MinIO 配置 ==========
MINIO_ENDPOINT=minio-staging.prod.svc.cluster.local:9000
MINIO_ACCESS_KEY=${MINIO_ACCESS_KEY}
MINIO_SECRET_KEY=${MINIO_SECRET_KEY}
MINIO_BUCKET=org-center-staging
MINIO_USE_SSL=true
MINIO_REGION=us-east-1

# ========== 消息队列配置 (NSQ) ==========
NSQ_LOOKUPD_ADDRESSES=nsqlookupd-staging.prod.svc.cluster.local:4161
NSQ_NSQD_ADDRESSES=nsqd-staging.prod.svc.cluster.local:4150
NSQ_PRODUCER_TIMEOUT=10s
NSQ_CONSUMER_MAX_IN_FLIGHT=100
NSQ_CONSUMER_MAX_ATTEMPTS=5

# ========== 监控配置 ==========
ENABLE_METRICS=true
METRICS_PORT=9090
METRICS_PATH=/metrics
ENABLE_PPROF=false
PPROF_PORT=6060

# ========== 分布式追踪配置 ==========
ENABLE_TRACING=true
JAEGER_ENDPOINT=http://jaeger-collector-staging.prod.svc.cluster.local:14268/api/traces
JAEGER_SAMPLER_TYPE=probabilistic
JAEGER_SAMPLER_PARAM=0.1  # 10% 采样
JAEGER_REPORTER_LOG_SPANS=false

# ========== 日志配置 ==========
LOG_LEVEL=info
LOG_FORMAT=json
LOG_OUTPUT=stdout
LOG_FILE_PATH=/var/log/org-center/app.log
LOG_MAX_SIZE=100  # MB
LOG_MAX_BACKUPS=10
LOG_MAX_AGE=30  # days
LOG_COMPRESS=true

# ========== 功能开关 ==========
FEATURE_ENABLE_MULTI_TENANT=true
FEATURE_ENABLE_RBAC=true
FEATURE_ENABLE_AUDIT_LOG=true
FEATURE_ENABLE_API_CACHE=true
FEATURE_ENABLE_SWAGGER=false
FEATURE_ENABLE_MOCK_DATA=false

# ========== 第三方服务配置 ==========
# 邮件服务
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@staging.example.com
SMTP_PASSWORD=${SMTP_PASSWORD}
SMTP_FROM=noreply@org-center.staging
SMTP_INSECURE_SKIP_VERIFY=false

# 短信服务（阿里云）
SMS_ACCESS_KEY=${SMS_ACCESS_KEY}
SMS_ACCESS_SECRET=${SMS_ACCESS_SECRET}
SMS_SIGN_NAME=组织中心测试
SMS_TEMPLATE_CODE=SMS_123456789

# 对象存储（七牛云）
QINIU_ACCESS_KEY=${QINIU_ACCESS_KEY}
QINIU_SECRET_KEY=${QINIU_SECRET_KEY}
QINIU_BUCKET=org-center-staging
QINIU_DOMAIN=https://cdn-staging.example.com

# ========== 安全配置 ==========
SECURITY_ENABLE_HTTPS=true
SECURITY_ENABLE_CSRF=true
SECURITY_SESSION_TIMEOUT=3600  # seconds
SECURITY_PASSWORD_MIN_LENGTH=8
SECURITY_PASSWORD_REQUIRE_UPPERCASE=true
SECURITY_PASSWORD_REQUIRE_LOWERCASE=true
SECURITY_PASSWORD_REQUIRE_NUMBER=true
SECURITY_PASSWORD_REQUIRE_SPECIAL=true

# ========== 国际化配置 ==========
I18N_ENABLED=true
I18N_DEFAULT_LANGUAGE=zh-CN
I18N_SUPPORTED_LANGUAGES=zh-CN,en-US

# ========== 测试配置 ==========
TEST_ENABLED=false
TEST_MOCK_EXTERNAL_API=false
TEST_SEED_DATA=false

# ========== 调试配置 ==========
DEBUG_ENABLED=false
DEBUG_PPROF_ENABLED=false
DEBUG_VERBOSE_SQL=false
DEBUG_VERBOSE_REDIS=false
DEBUG_VERBOSE_HTTP=false

# ========== 性能优化配置 ==========
CACHE_ENABLED=true
CACHE_TTL=300  # 5 minutes
CACHE_MAX_ITEMS=10000
GC_TARGET_PERCENT=100

# ========================================
# 说明:
# 1. 此配置用于预发布环境（Staging）
# 2. 配置接近生产环境，用于上线前的最后验证
# 3. 敏感信息通过环境变量或 Kubernetes Secret 管理
# 4. 启用完整的监控和追踪
# 5. 10% 采样率用于追踪，避免性能影响
# ========================================
