# ========================================
# 组织中心 (Organization Center) - 开发环境配置
# 环境名称: Development (开发环境)
# 用途: 本地开发和功能测试
# ========================================

# ========== 应用配置 ==========
APP_ENV=development
APP_LOG_LEVEL=debug
APP_PORT=8080
APP_NAME="Organization Center API"
APP_VERSION="1.0.0"

# ========== 服务器配置 ==========
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
SERVER_READ_TIMEOUT=60s
SERVER_WRITE_TIMEOUT=60s
SERVER_SHUTDOWN_TIMEOUT=30s

# ========== 数据库配置 (MySQL) ==========
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root_password_2025
DB_NAME=org_center_dev
DB_MAX_IDLE_CONNS=5
DB_MAX_OPEN_CONNS=20
DB_CONN_MAX_LIFETIME=1h
DB_CONN_MAX_IDLE_TIME=10m
DB_LOG_LEVEL=debug

# ========== Redis 配置 ==========
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_POOL_SIZE=20
REDIS_MIN_IDLE_CONNS=5
REDIS_MAX_RETRIES=3
REDIS_DIAL_TIMEOUT=5s
REDIS_READ_TIMEOUT=3s
REDIS_WRITE_TIMEOUT=3s
REDIS_POOL_TIMEOUT=4s

# ========== Elasticsearch 配置 ==========
ES_HOSTS=http://127.0.0.1:9200
ES_USERNAME=
ES_PASSWORD=
ES_INDEX_PREFIX=org_center_dev
ES_MAXRetries=3
ES_MAXIdleConns=10

# ========== JWT 配置 ==========
JWT_SECRET=dev_jwt_secret_key_2025_change_in_production
JWT_EXPIRE_TIME=24h
JWT_REFRESH_EXPIRE_TIME=168h  # 7 days
JWT_ISSUER=org-center-dev

# ========== 加密配置 ==========
ENCRYPTION_KEY=dev_encryption_key_32_bytes_long
AES_IV=dev_iv_16_bytes

# ========== CORS 配置 ==========
CORS_ENABLED=true
CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:8888
CORS_ALLOW_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOW_HEADERS=Content-Type,Authorization,X-Requested-With
CORS_ALLOW_CREDENTIALS=true
CORS_MAX_AGE=3600

# ========== 限流配置 ==========
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_SECOND=1000
RATE_LIMIT_BURST=2000
RATE_LIMIT_ENABLED_PER_IP=true
RATE_LIMIT_IP_REQUESTS_PER_SECOND=100
RATE_LIMIT_IP_BURST=200

# ========== 分页配置 ==========
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# ========== 文件上传配置 ==========
UPLOAD_ENABLED=true
UPLOAD_MAX_FILE_SIZE=104857600  # 100MB
UPLOAD_ALLOWED_EXTENSIONS=.jpg,.jpeg,.png,.gif,.pdf,.doc,.docx,.xls,.xlsx
UPLOAD_TEMP_DIR=/tmp/uploads

# ========== MinIO 配置 ==========
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=org-center-dev
MINIO_USE_SSL=false
MINIO_REGION=us-east-1

# ========== 消息队列配置 (NSQ) ==========
NSQ_LOOKUPD_ADDRESSES=127.0.0.1:4161
NSQ_NSQD_ADDRESSES=127.0.0.1:4150
NSQ_PRODUCER_TIMEOUT=10s
NSQ_CONSUMER_MAX_IN_FLIGHT=100
NSQ_CONSUMER_MAX_ATTEMPTS=5

# ========== 监控配置 ==========
ENABLE_METRICS=true
METRICS_PORT=9090
METRICS_PATH=/metrics
ENABLE_PPROF=true
PPROF_PORT=6060

# ========== 分布式追踪配置 ==========
ENABLE_TRACING=true
JAEGER_AGENT_HOST=127.0.0.1
JAEGER_AGENT_PORT=6831
JAEGER_SAMPLER_TYPE=const
JAEGER_SAMPLER_PARAM=1  # 100% 采样
JAEGER_REPORTER_LOG_SPANS=true

# ========== 日志配置 ==========
LOG_LEVEL=debug
LOG_FORMAT=json  # json or text
LOG_OUTPUT=stdout  # stdout, file, both
LOG_FILE_PATH=/var/log/org-center/app.log
LOG_MAX_SIZE=100  # MB
LOG_MAX_BACKUPS=3
LOG_MAX_AGE=28  # days
LOG_COMPRESS=true

# ========== 功能开关 ==========
FEATURE_ENABLE_MULTI_TENANT=true
FEATURE_ENABLE_RBAC=true
FEATURE_ENABLE_AUDIT_LOG=true
FEATURE_ENABLE_API_CACHE=true
FEATURE_ENABLE_SWAGGER=true
FEATURE_ENABLE_MOCK_DATA=false

# ========== 第三方服务配置 ==========
# 邮件服务
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=dev@example.com
SMTP_PASSWORD=dev_password
SMTP_FROM=noreply@org-center.dev
SMTP_INSECURE_SKIP_VERIFY=true

# 短信服务（如阿里云）
SMS_ACCESS_KEY=dev_access_key
SMS_ACCESS_SECRET=dev_access_secret
SMS_SIGN_NAME=组织中心测试
SMS_TEMPLATE_CODE=SMS_123456789

# 对象存储（如七牛云）
QINIU_ACCESS_KEY=dev_qiniu_access_key
QINIU_SECRET_KEY=dev_qiniu_secret_key
QINIU_BUCKET=org-center-dev
QINIU_DOMAIN=https://cdn-dev.example.com

# ========== 安全配置 ==========
SECURITY_ENABLE_HTTPS=false
SECURITY_ENABLE_CSRF=false
SECURITY_SESSION_TIMEOUT=3600  # seconds
SECURITY_PASSWORD_MIN_LENGTH=8
SECURITY_PASSWORD_REQUIRE_UPPERCASE=true
SECURITY_PASSWORD_REQUIRE_LOWERCASE=true
SECURITY_PASSWORD_REQUIRE_NUMBER=true
SECURITY_PASSWORD_REQUIRE_SPECIAL=false

# ========== 国际化配置 ==========
I18N_ENABLED=true
I18N_DEFAULT_LANGUAGE=zh-CN
I18N_SUPPORTED_LANGUAGES=zh-CN,en-US

# ========== 测试配置 ==========
TEST_ENABLED=true
TEST_MOCK_EXTERNAL_API=true
TEST_SEED_DATA=true

# ========== 调试配置 ==========
DEBUG_ENABLED=true
DEBUG_PPROF_ENABLED=true
DEBUG_VERBOSE_SQL=true
DEBUG_VERBOSE_REDIS=true
DEBUG_VERBOSE_HTTP=true

# ========================================
# 说明:
# 1. 此配置用于本地开发环境
# 2. 不要将此配置用于生产环境
# 3. 敏感信息（密码、密钥）应在生产环境中通过环境变量或 Secret 管理
# 4. 使用 Docker Compose 启动开发环境时，会使用此配置
# ========================================
