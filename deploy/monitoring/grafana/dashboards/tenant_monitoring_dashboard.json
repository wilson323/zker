{
  "dashboard": {
    "id": null,
    "title": "ZKER Tenant Monitoring Dashboard",
    "tags": ["zker", "tenant", "monitoring"],
    "timezone": "browser",
    "schemaVersion": 38,
    "version": 1,
    "refresh": "30s",
    "panels": [
      {
        "id": 1,
        "title": "Tenant QPS Overview",
        "type": "graph",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 0
        },
        "targets": [
          {
            "expr": "coze_qps{tenant_id=\"$tenant_id\"}",
            "legendFormat": "{{tenant_id}} - QPS",
            "refId": "A"
          }
        ],
        "yaxes": [
          {
            "format": "short",
            "label": "QPS",
            "show": true
          }
        ],
        "xaxis": {
          "show": true
        }
      },
      {
        "id": 2,
        "title": "Response Time Distribution",
        "type": "graph",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 0
        },
        "targets": [
          {
            "expr": "histogram_quantile(0.95, sum(rate(coze_http_request_duration_seconds_bucket{tenant_id=\"$tenant_id\"}[5m])) by (le))",
            "legendFormat": "P95 Response Time",
            "refId": "A"
          },
          {
            "expr": "histogram_quantile(0.99, sum(rate(coze_http_request_duration_seconds_bucket{tenant_id=\"$tenant_id\"}[5m])) by (le))",
            "legendFormat": "P99 Response Time",
            "refId": "B"
          },
          {
            "expr": "histogram_quantile(0.50, sum(rate(coze_http_request_duration_seconds_bucket{tenant_id=\"$tenant_id\"}[5m])) by (le))",
            "legendFormat": "P50 Response Time",
            "refId": "C"
          }
        ],
        "yaxes": [
          {
            "format": "s",
            "label": "Response Time",
            "show": true
          }
        ]
      },
      {
        "id": 3,
        "title": "Error Rate",
        "type": "graph",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 8
        },
        "targets": [
          {
            "expr": "coze_error_rate{tenant_id=\"$tenant_id\"}",
            "legendFormat": "Error Rate",
            "refId": "A"
          }
        ],
        "yaxes": [
          {
            "format": "percentunit",
            "label": "Error Rate",
            "show": true
          }
        ],
        "alert": {
          "conditions": [
            {
              "evaluator": {
                "params": [0.05],
                "type": "gt"
              },
              "operator": {
                "type": "and"
              },
              "query": {
                "params": ["A", "5m", "now"]
              },
              "reducer": {
                "params": [],
                "type": "avg"
              },
              "type": "query"
            }
          ],
          "executionErrorState": "alerting",
          "frequency": "1m",
          "handler": 1,
          "name": "High Error Rate Alert",
          "noDataState": "no_data",
          "notifications": []
        }
      },
      {
        "id": 4,
        "title": "Request Rate by Endpoint",
        "type": "graph",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 8
        },
        "targets": [
          {
            "expr": "sum(rate(coze_http_requests_total{tenant_id=\"$tenant_id\"}[5m])) by (endpoint)",
            "legendFormat": "{{endpoint}}",
            "refId": "A"
          }
        ],
        "yaxes": [
          {
            "format": "reqps",
            "label": "Requests / Second",
            "show": true
          }
        ]
      },
      {
        "id": 5,
        "title": "Health Score",
        "type": "stat",
        "gridPos": {
          "h": 4,
          "w": 6,
          "x": 0,
          "y": 16
        },
        "targets": [
          {
            "expr": "coze_health_score{tenant_id=\"$tenant_id\"}",
            "legendFormat": "Health Score",
            "refId": "A"
          }
        ],
        "options": {
          "colorMode": "value",
          "graphMode": "area",
          "orientation": "auto"
        },
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "min": 0,
            "max": 100,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "value": null,
                  "color": "red"
                },
                {
                  "value": 60,
                  "color": "yellow"
                },
                {
                  "value": 75,
                  "color": "green"
                }
              ]
            }
          }
        }
      },
      {
        "id": 6,
        "title": "Active Requests",
        "type": "gauge",
        "gridPos": {
          "h": 4,
          "w": 6,
          "x": 6,
          "y": 16
        },
        "targets": [
          {
            "expr": "coze_http_in_flight_requests{tenant_id=\"$tenant_id\"}",
            "legendFormat": "In-Flight Requests",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "min": 0,
            "max": 1000
          }
        }
      },
      {
        "id": 7,
        "title": "Total Requests",
        "type": "stat",
        "gridPos": {
          "h": 4,
          "w": 6,
          "x": 12,
          "y": 16
        },
        "targets": [
          {
            "expr": "sum(coze_http_requests_total{tenant_id=\"$tenant_id\"})",
            "legendFormat": "Total Requests",
            "refId": "A"
          }
        ]
      },
      {
        "id": 8,
        "title": "Average Response Time",
        "type": "stat",
        "gridPos": {
          "h": 4,
          "w": 6,
          "x": 18,
          "y": 16
        },
        "targets": [
          {
            "expr": "avg(coze_response_time_milliseconds{tenant_id=\"$tenant_id\"})",
            "legendFormat": "Avg Response Time",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "ms"
          }
        }
      },
      {
        "id": 9,
        "title": "Top 5 Slow Endpoints",
        "type": "table",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 20
        },
        "targets": [
          {
            "expr": "topk(5, avg(coze_http_request_duration_seconds{tenant_id=\"$tenant_id\"}) by (endpoint))",
            "legendFormat": "{{endpoint}}",
            "refId": "A",
            "format": "table"
          }
        ],
        "transformations": [
          {
            "id": "organize"
          }
        ]
      },
      {
        "id": 10,
        "title": "Error Requests by Status Code",
        "type": "piechart",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 20
        },
        "targets": [
          {
            "expr": "sum(coze_http_requests_total{tenant_id=\"$tenant_id\",status=~\"5..\"}) by (status)",
            "legendFormat": "{{status}}",
            "refId": "A"
          }
        ]
      }
    ],
    "templating": {
      "list": [
        {
          "name": "tenant_id",
          "type": "query",
          "query": "label_values(coze_qps, tenant_id)",
          "refresh": 1,
          "includeAll": false,
          "multi": false,
          "allValue": null,
          "current": {
            "text": "All",
            "value": "$__all"
          }
        }
      ]
    },
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "timepicker": {
      "refresh_intervals": ["5s", "10s", "30s", "1m", "5m", "15m", "30m", "1h", "2h", "1d"]
    }
  }
}
