{
  "dashboard": {
    "id": null,
    "title": "ZKER SLO/SLI 监控大盘",
    "tags": ["zker", "slo", "sli", "sla", "服务质量"],
    "timezone": "browser",
    "schemaVersion": 38,
    "version": 1,
    "refresh": "1m",
    "panels": [
      {
        "id": 1,
        "title": "SLO 总览",
        "type": "stat",
        "gridPos": {"h": 8, "w": 24, "x": 0, "y": 0},
        "targets": [
          {
            "expr": "(\n  sum(rate(zker_api_requests_total{status=~\"5..\"}[30d]))\n  /\n  sum(rate(zker_api_requests_total[30d]))\n)",
            "legendFormat": "错误率",
            "refId": "A"
          },
          {
            "expr": "histogram_quantile(0.95, sum(rate(zker_api_response_time_seconds_bucket[30d])) by (le))",
            "legendFormat": "P95延迟",
            "refId": "B"
          },
          {
            "expr": "(\n  sum(rate(zker_api_requests_total{status!~\"5..\"}[30d]))\n  /\n  sum(rate(zker_api_requests_total[30d]))\n)",
            "legendFormat": "可用性",
            "refId": "C"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "decimals": 4,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": null, "color": "green"},
                {"value": 80, "color": "yellow"},
                {"value": 90, "color": "red"}
              ]
            }
          }
        },
        "options": {
          "displayMode": "auto",
          "colorMode": "value"
        }
      },
      {
        "id": 2,
        "title": "可用性趋势（30天）",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
        "targets": [
          {
            "expr": "(\n  sum(rate(zker_api_requests_total{status!~\"5..\"}[30d]))\n  /\n  sum(rate(zker_api_requests_total[30d]))\n)",
            "legendFormat": "可用性",
            "refId": "A"
          }
        ],
        "yaxes": [
          {"format": "percentunit", "label": "可用性", "min": 0.99},
          {"format": "short"}
        ],
        "alert": {
          "conditions": [
            {
              "evaluator": {"params": [0.999], "type": "lt"},
              "operator": {"type": "and"},
              "query": {"params": ["A", "5m", "now"]},
              "reducer": {"params": [], "type": "avg"},
              "type": "query"
            }
          ],
          "executionErrorState": "alerting",
          "frequency": "1m",
          "handler": 1,
          "message": "可用性低于SLO目标 99.9%",
          "name": "可用性SLO告警",
          "noDataState": "no_data"
        }
      },
      {
        "id": 3,
        "title": "P95延迟趋势（30天）",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
        "targets": [
          {
            "expr": "histogram_quantile(0.95, sum(rate(zker_api_response_time_seconds_bucket[30d])) by (le))",
            "legendFormat": "P95延迟",
            "refId": "A"
          }
        ],
        "yaxes": [
          {"format": "s", "label": "延迟（秒）", "min": 0},
          {"format": "short"}
        ],
        "alert": {
          "conditions": [
            {
              "evaluator": {"params": [0.5], "type": "gt"},
              "operator": {"type": "and"},
              "query": {"params": ["A", "5m", "now"]},
              "reducer": {"params": [], "type": "avg"},
              "type": "query"
            }
          ],
          "executionErrorState": "alerting",
          "frequency": "1m",
          "handler": 1,
          "message": "P95延迟超过SLO目标 500ms",
          "name": "延迟SLO告警",
          "noDataState": "no_data"
        }
      },
      {
        "id": 4,
        "title": "错误率趋势（30天）",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
        "targets": [
          {
            "expr": "(\n  sum(rate(zker_api_requests_total{status=~\"5..\"}[30d]))\n  /\n  sum(rate(zker_api_requests_total[30d]))\n)",
            "legendFormat": "错误率",
            "refId": "A"
          }
        ],
        "yaxes": [
          {"format": "percentunit", "label": "错误率"},
          {"format": "short"}
        ],
        "alert": {
          "conditions": [
            {
              "evaluator": {"params": [0.001], "type": "gt"},
              "operator": {"type": "and"},
              "query": {"params": ["A", "5m", "now"]},
              "reducer": {"params": [], "type": "avg"},
              "type": "query"
            }
          ],
          "executionErrorState": "alerting",
          "frequency": "1m",
          "handler": 1,
          "message": "错误率超过SLO目标 0.1%",
          "name": "错误率SLO告警",
          "noDataState": "no_data"
        }
      },
      {
        "id": 5,
        "title": "错误预算剩余",
        "type": "gauge",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16},
        "targets": [
          {
            "expr": "((1 - 0.999) - (\n  sum(rate(zker_api_requests_total{status=~\"5..\"}[30d]))\n  /\n  sum(rate(zker_api_requests_total[30d]))\n)) / (1 - 0.999) * 100",
            "legendFormat": "误差预算剩余",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "min": 0,
            "max": 100,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": 0, "color": "red"},
                {"value": 25, "color": "yellow"},
                {"value": 50, "color": "green"}
              ]
            }
          }
        }
      },
      {
        "id": 6,
        "title": "按租户分组的可用性",
        "type": "table",
        "gridPos": {"h": 10, "w": 24, "x": 0, "y": 24},
        "targets": [
          {
            "expr": "(\n  sum by (tenant_id) (rate(zker_api_requests_total{status!~\"5..\"}[30d]))\n  /\n  sum by (tenant_id) (rate(zker_api_requests_total[30d]))\n)",
            "legendFormat": "{{tenant_id}}",
            "refId": "A",
            "format": "table"
          }
        ],
        "transformations": [
          {
            "id": "organize",
            "options": {
              "excludeByName": {"Time": true},
              "indexByName": {},
              "renameByName": {
                "tenant_id": "租户ID",
                "Value": "可用性"
              }
            }
          }
        ],
        "fieldConfig": {
          "defaults": {
            "custom": {"align": "left"},
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": null, "color": "green"},
                {"value": 0.999, "color": "yellow"},
                {"value": 0.99, "color": "red"}
              ]
            }
          }
        }
      },
      {
        "id": 7,
        "title": "SLA 合规状态（按套餐）",
        "type": "piechart",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 34},
        "targets": [
          {
            "expr": "count(sum by (tenant_id) (zker_api_requests_total{tenant_plan=\"enterprise\"}))",
            "legendFormat": "企业版",
            "refId": "A"
          },
          {
            "expr": "count(sum by (tenant_id) (zker_api_requests_total{tenant_plan=\"professional\"}))",
            "legendFormat": "专业版",
            "refId": "B"
          },
          {
            "expr": "count(sum by (tenant_id) (zker_api_requests_total{tenant_plan=\"basic\"}))",
            "legendFormat": "基础版",
            "refId": "C"
          }
        ]
      },
      {
        "id": 8,
        "title": "SLO 违规统计",
        "type": "stat",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 34},
        "targets": [
          {
            "expr": "count(ALERTS{slo_domain=~\".*\", alertstate=\"firing\"})",
            "legendFormat": "SLO违规数",
            "refId": "A"
          },
          {
            "expr": "count(ALERTS{sla_tier=~\".*\", alertstate=\"firing\"})",
            "legendFormat": "SLA违规数",
            "refId": "B"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "thresholds"},
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": null, "color": "green"},
                {"value": 0, "color": "green"},
                {"value": 1, "color": "yellow"},
                {"value": 5, "color": "red"}
              ]
            }
          }
        }
      }
    ]
  }
}
