      "targets": [
        {
          "expr": "db_connections_active"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "max": 100,
          "min": 0
        }
      }
    },
    {
      "datasource": "Prometheus",
      "id": 18,
      "gridPos": {
        "h": 8,
        "w": 8
      },
      "type": "gauge",
      "title": "空闲连接数",
      "targets": [
        {
          "expr": "db_connections_idle"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "max": 100,
          "min": 0
        }
      }
    },
    {
      "datasource": "Prometheus",
      "id": 19,
      "gridPos": {
        "h": 8,
        "w": 8
      },
      "type": "graph",
      "title": "查询QPS",
      "targets": [
        {
          "expr": "rate(db_query_total[1m])",
          "legendFormat": "{{operation}} - {{table}}"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "id": 20,
      "gridPos": {
        "h": 8,
        "w": 12
      },
      "type": "graph",
      "title": "查询延迟 (P95)",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(db_query_duration_seconds_bucket[5m]))",
          "legendFormat": "{{operation}} - {{table}}"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "id": 21,
      "gridPos": {
        "h": 8,
      "w": 12
      },
      "type": "graph",
      "title": "查询错误率",
      "targets": [
        {
          "expr": "rate(db_query_errors_total[5m]) / rate(db_query_total[5m]) * 100",
          "legendFormat": "{{operation}} - {{table}}"
        }
      ],
      "yaxes": [
        {
          "label": "Error Rate (%)",
          "max": 100,
          "min": 0,
          "show": true
        }
      ]
    },
    {
      "collapsed": false,
      "datasource": null,
