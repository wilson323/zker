      "title": "HTTP请求监控",
      "type": "row"
    },
    {
      "datasource": "Prometheus",
      "id": 7,
      "gridPos": {
        "h": 8,
        "w": 12
      },
      "type": "graph",
      "title": "HTTP请求QPS",
      "targets": [
        {
          "expr": "rate(http_requests_total[1m])",
          "legendFormat": "{{method}} {{path}}"
        }
      ],
      "yaxes": [
        {
          "label": "Requests/sec",
          "show": true
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "id": 8,
      "gridPos": {
        "h": 8,
        "w": 12
      },
      "type": "graph",
      "title": "HTTP请求延迟 (P95)",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(http_request_duration_seconds_bucket[5m]))",
          "legendFormat": "{{method}} {{path}}"
        }
      ],
      "yaxes": [
        {
          "label": "Seconds",
          "show": true
        }
      ]
    },
    {
      "collapsed": false,
