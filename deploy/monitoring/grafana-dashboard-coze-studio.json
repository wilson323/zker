        {
          "expr": "topk(10, quota_usage_percentage)",
          "legendFormat": "{{tenant_id}} - {{resource_type}}"
        }
      ],
      "yaxes": [
        {
          "label": "Percentage",
          "max": 100,
          "show": true,
          "min": 0
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "id": 15,
      "gridPos": {
        "h": 8,
        "w": 12
      },
      "type": "graph",
      "title": "配额超限事件",
      "targets": [
        {
          "expr": "rate(quota_exceeded_total[5m])",
          "legendFormat": "{{tenant_id}} - {{resource_type}}"
        }
      ]
    },
    {
      "collapsed": false,
      "datasource": null,
      "id": 16,
      "gridPos": {
        "h": 1,
        "w": 24
      },
